+#ifndef ACORE_CREATURE_TERRAIN_REFRESH_H
+#define ACORE_CREATURE_TERRAIN_REFRESH_H
+
+#include "Define.h"
+
+namespace Acore::AutoWowPerf
+{
+    // AutoWoW perf R1: pure throttle predicate for the creature terrain/position-data refresh
+    // done by Map::CreatureRelocation (AutoWow.Perf.CreatureTerrainRefreshMs / ...Yards).
+    // refreshMs == 0 && refreshYards <= 0 -> throttle OFF, always refresh (legacy behavior).
+    // Otherwise refresh when forced, when moved >= refreshYards (squared compare, yards > 0),
+    // or when >= refreshMs elapsed since the last full refresh (ms > 0).
+    inline bool ShouldRefreshCreatureTerrain(uint32 refreshMs, float refreshYards, bool forced, float distSqSinceRefresh, uint32 msSinceRefresh)
+    {
+        if (!refreshMs && refreshYards <= 0.0f)
+            return true;
+
+        if (forced)
+            return true;
+
+        if (refreshYards > 0.0f && distSqSinceRefresh >= refreshYards * refreshYards)
+            return true;
+
+        return refreshMs && msSinceRefresh >= refreshMs;
+    }
+}
+
+#endif
