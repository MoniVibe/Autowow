 src/server/game/Entities/Creature/Creature.h  | 15 +++++
 .../Creature/CreatureTerrainRefresh.h         | 45 +++++++++++++++
 src/server/game/Maps/Map.cpp                  |  4 +-
 src/server/game/World/WorldConfig.cpp         |  4 ++
 src/server/game/World/WorldConfig.h           |  2 +
