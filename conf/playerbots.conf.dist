####################################################################################################

###################################
#                                 #
# RAIDS                           #
#                                 #
###################################

####################################################################################################
#
#

# Enable buffs in ICC to make Heroic easier and more casual.
# 30% more damage, 40% damage reduction (tank bots), increased all resistances, reduced threat for
# non-tank bots, increased threat for tank bots.
# Buffs will be applied on LDW, PP, Sindragosa and Lich King.
# Default: 1 (enabled)
AiPlayerbot.EnableICCBuffs = 1

#
#
####################################################################################################

###################################
#                                 #
# PLAYERBOTS SYSTEM SETTINGS      #
#                                 #
###################################

####################################################################################################
# DATABASE & CONNECTIONS
#
#    PlayerbotsDatabaseInfo
#        Description: Database connection settings for the playerbots server.
#        Example:     "hostname;port;username;password;database"
#                     ".;somenumber;username;password;database" - (Use named pipes on Windows
#                                                                 "enable-named-pipe" to [mysqld]
#                                                                 section my.ini)
#                     ".;/path/to/unix_socket;username;password;database" - (use Unix sockets on
#                                                                           Unix/Linux)
#        Default:     "127.0.0.1;3306;acore;acore;acore_playerbots"       - (PlayerbotDatabaseInfo)

PlayerbotsDatabaseInfo = "127.0.0.1;3306;acore;acore;acore_playerbots"

#    PlayerbotsDatabase.WorkerThreads
#        Description: The amount of worker threads spawned to handle asynchronous (delayed) MySQL
#                     statements. Each worker thread is mirrored with its own connection to the
#                     MySQL server and their own thread on the MySQL server.
#        Default:     1 - (PlayerbotsDatabase.WorkerThreads)

PlayerbotsDatabase.WorkerThreads     = 1

#    PlayerbotsDatabase.SynchThreads
#        Description: The amount of MySQL connections spawned to handle.
#        Default:     1 - (PlayerbotDatabase.WorkerThreads)

PlayerbotsDatabase.SynchThreads     = 1

#    Playerbot.Updates.EnableDatabases
#        Description: Determined if updates system work with playerbots database.
#
#        Default:     1  - (Enabled)
#                     0  - (Disabled)

Playerbots.Updates.EnableDatabases = 1

# Legacy Playerbots diagnostic command server port, 0 - disabled.
# AutoWoW keeps this disabled because its protocol has no authentication.
AiPlayerbot.CommandServerPort = 0

# AutoWow local control bridge port, 0 - disabled. It always binds to 127.0.0.1.
AutoWow.BridgePort = 18787

# AutoWow Oracle runtime is a default-off, world-thread-only quest objective driver. Its default
# mode has no database, teleport, or catch-up loop. Enable only with a dedicated decimal character GUID list;
# GUIDs are normalized sorted/deduped nonzero entries, CadenceMs is 100..5000, and MaxBots is
# capped at AutoWowOracle::kMaxBotLeases.
AutoWow.OracleRuntime.Enabled = 0
# Opt-in recovery for managed Oracle quest bots: after a bounded route stall or recoverable
# exact-target failure, teleport to that quest spawn only when it is in the bot's current zone.
# Ordinary routes, cross-zone travel, and all objective/quest interactions remain native.
AutoWow.OracleRuntime.ZoneTravelAssist = 0
AutoWow.OracleRuntime.BotGuids = ""
AutoWow.OracleRuntime.CadenceMs = 1000
AutoWow.OracleRuntime.MaxBots = 1
AutoWow.OracleRuntime.LeaseTtlTicks = 3
# Round-robin world-tick slicing for the Oracle pass. 0 (default) drives every managed bot on the
# cadence edge in one world update (legacy behavior). N > 0 drives at most N bots per world update
# in ascending-GUID order; a new cadence edge first finishes any unfinished pass, so every bot still
# runs exactly once per CadenceMs. Pick N >= ceil(MaxBots * worldDiffMs / CadenceMs) to avoid
# drain bursts at the edge. Requires LeaseTtlTicks >= 2 (else the runtime disables itself).
AutoWow.OracleRuntime.SliceBots = 0
# Defer a managed quest directive that yields nothing the Oracle can lease: the quest frame cannot
# be built (typically a completed quest whose finisher is only on another map) or it has zero
# candidates (typically objective sources only on another map). Without this, such a directive is
# kept forever and the bot idles silently. N > 0 = after N consecutive lease-less cadence passes,
# set the quest aside like an unrunnable one (native low-priority set, ledger `deferred` with
# reason oracle_no_frame / oracle_no_candidate); quest state is never touched. 0 (default) = legacy.
AutoWow.OracleRuntime.DeferNoCandidatePasses = 0
# Keep Oracle-managed bots out of RandomPlayerbotMgr random relocations (level-up
# AutoTeleportForLevel, scheduled teleport-for-level, revive grind teleport, rpg teleport). Those
# move a managed bot away from the zone its quest log belongs to. Read once. 0 (default) = legacy.
AutoWow.OracleRuntime.NoRandomTeleport = 0

# Explicitly deployed worker_gather route seeking. Candidates are remembered static herb/ore
# spawns; spawned state is checked only after the bot walks into sight. Movement uses mmap-backed
# MoveFarTo with teleport recovery disabled. SearchDistance is yards, SightDistance is the local
# live-object handoff radius, and misses (despawned/pool-inactive/unreachable nodes) cool down per bot.
AutoWow.GatherSeek.Enabled = 1
AutoWow.GatherSeek.SearchDistance = 1200
AutoWow.GatherSeek.SightDistance = 55
AutoWow.GatherSeek.MissCooldownSeconds = 300
AutoWow.GatherSeek.MaxNodeLevelAboveBot = 5

# AutoWow Observer Camera allow-list: comma/space separated character GUIDs permitted to use
# the loopback `observe` bridge order (watch/relocate/status/protect/release). Empty (default)
# means NO character may be driven as an observer. Only enroll a dedicated, GM-level observer
# character here; the observer must never be a Playerbots bot and must not join bot groups.
AutoWow.ObserverGuids = ""

# AutoWow existing-character fixture allow-list: comma/space separated character GUIDs permitted
# to use `fixture init <guid> <level> <spec-index> <quality>` and `fixture status <guid>`.
# Empty (default) means NO fixture target is permitted. Targets must already be online Playerbots;
# human/session observers and discoverable league racer/captain roles are rejected. The numeric
# quality enum is constrained to 0..5 (poor through legendary), and spec-index to 0..19.
AutoWow.FixtureGuids = ""

# Per-quest PROBE setup verbs on the loopback bridge: `probe-login <guid>`,
# `probe-setlevel <guid> <level> [<spec-index> <quality>]` (up OR down; downlevel resets talents and
# unlearns spells above the target level, then re-runs the fixture-init spell/talent/exact-quality
# gear path; no other gear is granted), `probe-place <guid> <questId> [drop-others]` (clears the
# quest's status/reward and quest-class objective items, then teleports to the deterministic
# creature/gameobject quest-starter spawn; ledger `contaminated` reason `probe_setup`), and
# `probe-status <guid> [<questId>]`. Every verb is limited to AutoWow.FixtureGuids and refuses the
# cohort range 62955-63004 and any GUID in AutoWow.OracleRuntime.BotGuids.
# Default 0: every probe verb is refused with `probe_disabled`.
AutoWow.Probe.Enable = 0

# Fixture-only accelerated micro-scenario allow-list. Empty (default) means no character may
# receive 1000%-of-baseline (10x) pacing or exact-target fixture kills. Keep these GUIDs separate
# from FixtureGuids and from persistent campaign/league rosters; the adapter never grants quest or
# gather credit directly and always uses native server hooks.
AutoWow.MicroScenarioGuids = ""

# AutoWow per-quest ledger. When enabled, playerbots (never real players) emit one single-line JSON
# event (schema v1) per quest lifecycle step to logger `autowow.ledger`: accepted, rewarded,
# abandoned, blocked (typed executor reason + phase), deferred (set aside / dropped) and
# contaminated (randombot revive/randomize/teleport, Oracle ZoneTravelAssist teleport, and every other
# bot-initiated teleport: rpg_stuck_teleport, corpse_run_teleport, ghost_graveyard_teleport,
# arena_team_teleport, bridge_rally_teleport, bridge_route_teleport, probe_reset_teleport,
# dungeon_ground_reattach), plus bot-level
# died (killer kind/id/level) and pvp_kill (victim guid/level, honorable).
# Route the logger to its own file appender in worldserver.conf, on a native (ext4) filesystem.
# Read once at world init. Default 0 = disabled (one cached bool check per call site, nothing logged).
AutoWow.Ledger.Enable = 0
# Free-form run label copied into every line's "run" field so the offline reducer keys rows by
# (run, bot, quest). Default empty.
AutoWow.Ledger.RunId = ""
# Blocked-row dedupe window (ms). 0 (default) = one `blocked` line per occurrence (legacy). N > 0 =
# emit `blocked` only when (quest, reason, phase) changes, plus one heartbeat line per N ms of
# repeats carrying a count field `n` (occurrences the line stands for). 60000 is the soak value.
AutoWow.Ledger.BlockedDedupeMs = 0
# Objective-progress sampling (ms). 0 (default) = off. N > 0 (with AutoWow.Ledger.Enable) = every N ms
# per bot, diff each quest-log entry's core counters (c[4] creature/GO, i[6] item) against the last
# sample and emit one `progress` line per quest whose counters changed. The first sample of a quest
# only records a baseline (its `accepted` line already carries the counters). 60000 is the soak value.
AutoWow.Ledger.ProgressSampleMs = 0
# Profession skill events. 0 (default) = off. 1 (with AutoWow.Ledger.Enable) = one `skill_up` line
# (fields skill, old, new, max, cause) per profession skill change of a bot: cause update (core skill
# gain from gathering/crafting/fishing), learn (a new profession, old 0) or rank (a rank-up at a
# trainer: value unchanged, max raised). Only the 14 profession lines. Fold with AutoWoW
# scripts/cohort/faction-progress.ps1 -Ledger (real-time faction profession-skill KPI).
AutoWow.Ledger.SkillUp = 0

# AutoWoW combat telemetry (C1). Default 0 = inert: hooks early-return on one cached bool and the
# bridge `combatlog` counters (autowow.combat-counters.v1) behave exactly as before.
# 1 = count player-side combat entries (OnPlayerEnterCombat) into v1 `combat.entries`, which the core
# otherwise only raises for creatures. Read once at world init.
AutoWow.CombatTelemetry.Enable = 0
# With Enable = 1 (C2/C4/C6): per-bot lifetime totals (wall/combat/dead/starved ms, damage, healing,
# fights, kills, deaths, casts, GCD casts, DoT-gate skips, kill TTK samples) are emitted every
# LogIntervalMs as a bot-level `combat` event (schema cv=1, quest 0) on logger `autowow.ledger`
# (needs AutoWow.Ledger.Enable = 1), plus one final line at logout. Fold with
# AutoWoW scripts/combat-reduce.py. 0 = never emit (totals still accumulate). Default 60000.
AutoWow.CombatTelemetry.LogIntervalMs = 60000

# AutoWoW DoT/debuff lifetime gate (C5). Default 0 = off (one cached bool per debuff trigger/action).
# 1 = do not apply or refresh a DoT (corruption, curses of agony/doom, immolate, unstable affliction,
# siphon life, seed, shadow word: pain, vampiric touch, devouring plague, moonfire, insect swarm, rake,
# rip, lacerate, serpent sting, rupture, garrote, rend, frost fever/blood plague, icy touch, plague
# strike, flame shock, living bomb) or a debuff (hunter's mark, curses of elements/weakness/exhaustion/
# tongues, sunder armor, faerie fire, expose armor) on a normal/rare creature that is below
# DotMinTargetHpPct, or - DoTs only - whose estimated time-to-kill is below DotMinDurationPct of the
# DoT duration, or shorter than the bot's own running DoT (refresh). Never gated: elites, rare elites,
# bosses, dungeon/world bosses, players. HP-floor exception: remaining HP >= bot level x
# DotHighHpPerLevel. TTK = observed HP loss rate since the bot engaged the target, floored by the bot's
# recent DPS; it needs AutoWow.CombatTelemetry.Enable = 1 (otherwise only the HP floor applies).
# Skips are counted in the `combat` ledger event field dot_skips.
AutoWow.Combat.DotLifetimeGate = 0
AutoWow.Combat.DotMinTargetHpPct = 10
AutoWow.Combat.DotMinDurationPct = 50
AutoWow.Combat.DotHighHpPerLevel = 150

# AutoWoW tactical combat layer (docs/TACTICAL_COMBAT_PLAN.md; TacticalPolicy.h). Default 0 = off: the
# bot AI tick and the telemetry hooks early-return on one cached bool. Solo bots of the classes in
# Classes only (not grouped, not in a dungeon/raid/battleground/arena). Read once at world init.
# Observe = 1 (T1, no behaviour change): every ReevalMs (and on every combat-state change) the bot's
# engagement is assessed (attackers, melee, idle adds within LinkRadius yards of an attacker, levels,
# elites, casters, hp/mana, hp-slope death eta, Scream/Shield/wand readiness) and labelled with the
# tactic it WOULD run (10 wand, 11 burst, 12 multi, 13 emergency, 14 escape). One ledger `engage` line
# per engagement (needs AutoWow.Ledger.Enable = 1). With AutoWow.CombatTelemetry.Enable = 1 the bot's
# `combat` lines become cv=2 (cv=1 fields unchanged + tac_ms, arm). arm = hash(guid, ArmSalt) % 100 <
# ArmPct (1 = treatment); in Observe mode it is a label only.
AutoWow.Tactics.Observe = 0
AutoWow.Tactics.ArmPct = 50
AutoWow.Tactics.ArmSalt = 1
AutoWow.Tactics.ReevalMs = 500
AutoWow.Tactics.LinkRadius = 12
# Tactic choice (integer percent / ms). Load and capacity are centi mob-equivalents: a lone same-level
# normal mob = 100; w = rankMul x clamp(1 + LvlStepPct% x dlvl, 0.4, 2.0) x (mana-class ? CasterMulPct%).
# Capacity = (BasePct + 100 if Scream ready + 50 if Shield ready) x hp% x (0.5 + 0.5 mana%).
# Single (load <= SingleMaxPct): wand-cycle for a cheap fight (lone normal mob, not a caster, <= +1 level)
# or when mana < WandManaPct, else burst (burst hands off to the wand below BurstExitManaPct); no wand
# equipped = burst. Multi above SingleMaxPct. Emergency below EmergencyHpPct or when the hp-slope death
# eta < DeathEtaMs; leaves above EmergencyExitHpPct. Escape (one attempt per engagement, EscapeMaxMs):
# load > capacity x EscapeRatioPct%, hp below EmergencyExitHpPct, >= 2 attackers and the known control
# tools on cooldown. Escalation is immediate; any other switch waits MinDwellMs.
AutoWow.Tactics.MinDwellMs = 3000
AutoWow.Tactics.DeathEtaMs = 6000
AutoWow.Tactics.EscapeRatioPct = 160
AutoWow.Tactics.EscapeMaxMs = 8000
AutoWow.Tactics.Load.EliteMulPct = 300
AutoWow.Tactics.Load.RareMulPct = 150
AutoWow.Tactics.Load.LvlStepPct = 15
AutoWow.Tactics.Load.CasterMulPct = 120
AutoWow.Tactics.Priest.SingleMaxPct = 120
AutoWow.Tactics.Priest.BasePct = 100
AutoWow.Tactics.Priest.WandManaPct = 60
AutoWow.Tactics.Priest.BurstExitManaPct = 50
AutoWow.Tactics.Priest.ShieldMinManaPct = 20
AutoWow.Tactics.Priest.RenewHpPct = 70
AutoWow.Tactics.Priest.HealHpPct = 45
AutoWow.Tactics.Priest.EmergencyHpPct = 30
AutoWow.Tactics.Priest.EmergencyExitHpPct = 45
AutoWow.Tactics.Priest.ScreamMinMelee = 2
AutoWow.Tactics.Priest.ScreamHpPct = 60
# Enable = 1 (T2): tracking as Observe, plus treatment-arm priests (arm 1) get the "tactical" combat and
# "tactical nc" non-combat strategies. Control-arm priests run stock in the same soak (labelled only).
# Tactics drive the stock engine through triggers and an action-factor multiplier (no strategy swaps):
#   wand (10): SW:P then wand to the end (never re-cast while the wand is shooting the target); PW:S only
#     above ShieldMinManaPct; Renew below RenewHpPct, Heal below HealHpPct.
#   burst (11): stock nuke rotation; same Renew/Heal floors.
#   multi (12): SW:P spread over attackers, Renew/Heal floors +10, Psychic Scream when >= ScreamMinMelee
#     fearable melee are on the bot, (hp < ScreamHpPct or >= 3 attackers) and no idle adds are near.
#   emergency (13): Desperate Prayer, Scream (any fearable melee), PW:S, Flash Heal (-> Greater/Heal/Lesser),
#     Renew; damage spells x0 except the wand.
#   escape (14): Scream if ready, flee step; all damage x0.
# Factors.<Tactic> = "action:factor,..." (unlisted actions keep 1; 0 suppresses; the defaults are below).
# Pre-pull readiness: no proactive grind/quest pull below PullMinManaPct / PullMinHpPct (0 = off); the bot
# drinks / eats up to them instead (self-defence unaffected). Pack risk: a pull candidate with idle
# hostiles within LinkRadius is rejected when candidate + neighbours > capacity x EscapeRatioPct%, else
# sorted after lone candidates (quest branch: after party-shared, before distance; grind: + RiskYd yards
# per whole mob-equivalent).
AutoWow.Tactics.Enable = 0
AutoWow.Tactics.PullMinManaPct = 50
AutoWow.Tactics.PullMinHpPct = 60
AutoWow.Tactics.RiskYd = 15
AutoWow.Tactics.Priest.Factors.Wand = "smite:0,mind blast:0,holy fire:0,mana burn:0,mind flay:0,starshards:0,holy nova:0"
AutoWow.Tactics.Priest.Factors.Burst = ""
AutoWow.Tactics.Priest.Factors.Multi = "smite:0.5,mana burn:0"
AutoWow.Tactics.Priest.Factors.Emergency = "smite:0,mind blast:0,holy fire:0,mana burn:0,mind flay:0,starshards:0,holy nova:0,shadow word: pain:0,shadow word: pain on attacker:0,devouring plague:0,vampiric touch:0,shadow word: death:0,mind sear:0"
AutoWow.Tactics.Priest.Factors.Escape = "smite:0,mind blast:0,holy fire:0,mana burn:0,mind flay:0,starshards:0,holy nova:0,shadow word: pain:0,shadow word: pain on attacker:0,devouring plague:0,vampiric touch:0,shadow word: death:0,mind sear:0,shoot:0"
# PriestShadowLevelingSpec = 1: non-random priests take premade spec 5.6 (above) on a first talent pick, a
# reset (AutoMaintenance level-up respec) or while already shadow. Random bots are untouched. Note: shadow
# priests have no stock self-heal; the tactical strategy (Enable, treatment arm) supplies Renew/Heal.
AutoWow.Tactics.PriestShadowLevelingSpec = 0
# Classes: the classes the layer tracks (Observe) and treats (Enable), "all" or names separated by ',' or ' '
# (priest, warrior, rogue, mage, shaman, paladin, hunter, druid, warlock, deathknight). Default "priest" =
# the priest-only behaviour above. The arm hash (ArmPct / ArmSalt) applies within every class. Every
# non-priest class runs the same ladder: single (<id>0), multi (<id>2, load > SingleMaxPct), emergency
# (<id>3, hp < EmergencyHpPct or death eta < DeathEtaMs; leaves above EmergencyExitHpPct), escape (<id>4,
# one attempt: load > capacity x EscapeRatioPct%, hp < EmergencyExitHpPct, >= 2 attackers, the known
# control/defensive cooldowns spent, an escape tool ready; a class without one fights on). Class ids: warlock 2x, mage 3x, hunter 4x, rogue 5x, warrior 6x,
# paladin 7x, druid 8x, shaman 9x, death knight 10x. Capacity = (BasePct + 100 if a control tool is ready
# + 50 if a defensive cooldown is ready + 100 while a pet is alive) x hp% x (0.5 + 0.5 mana%). Per class:
# <Class>.SingleMaxPct / BasePct / HealHpPct (self-heal or defensive floor while fighting, +10 in multi) /
# LowManaPct / EmergencyHpPct / EmergencyExitHpPct / ControlMinMelee / ControlHpPct (area control needs
# ControlMinMelee controllable melee on the bot and hp < ControlHpPct or >= 3 attackers, no idle adds near)
# and <Class>.Factors.{Single,Multi,Emergency,Escape} ("action:factor,..."; the defaults are below). A
# class listed before its tactics exist is ignored. Pre-pull readiness stays priest-only (other classes:
# AutoWow.Survival.RestGate); pack-risk pull choice applies to every treated class.
AutoWow.Tactics.Classes = "priest"
# Observe-only classes (default ""): the listed classes get the tactical assessment and ledger `engage`
# rows (arm 0, never treated), even with AutoWow.Tactics.Observe / Enable off. Unlike adding them to
# Classes, this never turns their tactics on under Enable. Same names as Classes ("rogue,mage", "all").
AutoWow.Tactics.ObserveClasses = ""
# Warrior (60 single, 62 multi, 63 emergency, 64 escape; TacticalClassStrategy.cpp WarriorNodes): Hamstring on
# a fleeing target, Victory Rush below HealHpPct; multi Thunder Clap / Demoralizing Shout / Cleave and
# Intimidating Shout; emergency shout / Victory Rush / Last Stand (no stance-bound cooldowns: their stance
# prerequisites flapped stances and dumped rage); never escapes (no escape tool). Tools: shout (control),
# Retaliation / Last Stand (defensive).
AutoWow.Tactics.Warrior.SingleMaxPct = 120
AutoWow.Tactics.Warrior.BasePct = 100
AutoWow.Tactics.Warrior.HealHpPct = 50
AutoWow.Tactics.Warrior.LowManaPct = 25
AutoWow.Tactics.Warrior.EmergencyHpPct = 30
AutoWow.Tactics.Warrior.EmergencyExitHpPct = 45
AutoWow.Tactics.Warrior.ControlMinMelee = 2
AutoWow.Tactics.Warrior.ControlHpPct = 60
AutoWow.Tactics.Warrior.Factors.Single = "sunder armor:0,heroic strike:0.5,rend on attacker:0"
AutoWow.Tactics.Warrior.Factors.Multi = "sunder armor:0,heroic strike:0,rend on attacker:0,rend:0.5"
AutoWow.Tactics.Warrior.Factors.Emergency = "sunder armor:0,heroic strike:0,cleave:0,bloodrage:0,rend:0,rend on attacker:0,charge:0,mocking blow:0"
AutoWow.Tactics.Warrior.Factors.Escape = "sunder armor:0,heroic strike:0,cleave:0,bloodrage:0,rend:0,rend on attacker:0,charge:0,mocking blow:0,overpower:0,mortal strike:0,execute:0,slam:0,whirlwind:0,bloodthirst:0,melee:0,reach melee:0"
# Rogue (50/52/53/54; RogueNodes): Evasion below HealHpPct; multi Blade Flurry (Evasion waits for HealHpPct);
# emergency Evasion / Kidney Shot; escape Vanish / Gouge / Sprint / flee. Tools: Gouge / Kidney Shot / Blind
# (control), Evasion (defensive), Vanish / Sprint (escape).
AutoWow.Tactics.Rogue.SingleMaxPct = 120
AutoWow.Tactics.Rogue.BasePct = 100
AutoWow.Tactics.Rogue.HealHpPct = 50
AutoWow.Tactics.Rogue.LowManaPct = 25
AutoWow.Tactics.Rogue.EmergencyHpPct = 30
AutoWow.Tactics.Rogue.EmergencyExitHpPct = 45
AutoWow.Tactics.Rogue.ControlMinMelee = 2
AutoWow.Tactics.Rogue.ControlHpPct = 60
AutoWow.Tactics.Rogue.Factors.Single = "rupture:0,expose armor:0,feint:0"
AutoWow.Tactics.Rogue.Factors.Multi = "rupture:0,expose armor:0,feint:0,slice and dice:0.5"
AutoWow.Tactics.Rogue.Factors.Emergency = "rupture:0,expose armor:0,feint:0,slice and dice:0"
AutoWow.Tactics.Rogue.Factors.Escape = "rupture:0,expose armor:0,feint:0,slice and dice:0,sinister strike:0,eviscerate:0,backstab:0,mutilate:0,kick:0,melee:0,reach melee:0"
# Mage (30/32/33/34; MageNodes): Frost Nova on a melee attacker and step out of a lone rooted/frozen target;
