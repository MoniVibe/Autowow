+    // AutoWoW perf R1: throttle for the terrain refresh done by Map::CreatureRelocation.
+    [[nodiscard]] bool ShouldRefreshTerrainOnRelocation(bool cellChanged) const;
+    void ProcessPositionDataChanged(PositionFullTerrainStatus const& data) override;
     uint32 GetRandomId(uint32 id1, uint32 id2, uint32 id3);
     bool UpdateEntry(uint32 entry, const CreatureData* data = nullptr, bool changelevel = true, bool updateAI = false);
     bool UpdateEntry(uint32 entry, bool updateAI) { return UpdateEntry(entry, nullptr, true, updateAI); }
@@ -525,6 +529,17 @@ protected:
     bool IsAlwaysDetectableFor(WorldObject const* seer) const override;
 
 private:
+    // AutoWoW perf R1: stamp of the last full terrain refresh (set in ProcessPositionDataChanged).
+    Position _terrainRefreshPos;
+    uint32 _terrainRefreshMs = 0;
+    uint32 _terrainRefreshPhase = 0;
+    bool _terrainRefreshValid = false;
+
+    // AutoWoW perf R2: GetScriptId cache; the resolved id depends only on entry + m_creatureData.
+    mutable uint32 _scriptIdCacheEntry = 0; // 0 = empty (no creature has entry 0)
+    mutable CreatureData const* _scriptIdCacheData = nullptr;
+    mutable uint32 _scriptIdCache = 0;
+
     void ForcedDespawn(Milliseconds timeMSToDespawn = 0ms, Seconds forcedRespawnTimer = 0s);
 
     [[nodiscard]] bool CanPeriodicallyCallForAssistance() const;
