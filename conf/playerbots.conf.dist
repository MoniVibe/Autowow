# AutoWoW death-loop breaker. Default 0 = off (one cached bool per hook/call site; legacy paths
# untouched). 1 = an autonomous bot's open-world death escalates when it is the Deaths-th death within
# WindowMs within RadiusYards (same map), or the killer is >= KillerLevelGap levels above the bot
# (0 disables that rule; Deaths = 0 disables the cluster rule). An escalated death:
#   - takes the spirit-healer resurrection at the graveyard instead of the corpse run / reclaim;
#   - marks the death cluster (centroid, RadiusYards) as a danger area for this bot for
#     DangerCooldownMs: New RPG grind/camp picks skip it, quests with an objective POI inside it are
#     deferred (ledger `deferred` reason death_loop_area), and the quest the bot was working is
#     deferred (Oracle-managed: through the Oracle's own defer path);
#   - when the zone's level bracket starts more than RelocateLevelMargin above the bot, makes one
#     relocation attempt through the ordinary New RPG flight-travel status (walk to the flight master,
#     fly to a zone bracketing the bot's level; no teleport).
# Each escalation emits a ledger `death_loop` line. Bots following a real player, gather workers,
# battlegrounds/arenas and dungeon/raid deaths are never escalated. Read once at world init.
AutoWow.DeathLoop.Enable = 0
AutoWow.DeathLoop.Deaths = 3
AutoWow.DeathLoop.WindowMs = 1800000
AutoWow.DeathLoop.RadiusYards = 60
AutoWow.DeathLoop.KillerLevelGap = 10
AutoWow.DeathLoop.DangerCooldownMs = 3600000
AutoWow.DeathLoop.RelocateLevelMargin = 5
# EscapeViaZoneProgression (default 0; needs Enable and AutoWow.ZoneProgression.Enable): the relocation
# becomes a zone-progression trip (independent bots; others keep the flight relocation) to the nearest
# hub of a route for the bot's team whose level band holds its level (hubs on its map first), and an
# independent bot idle in a zone whose bracket starts more than RelocateLevelMargin above it escapes the
# same way without dying. With AutoWow.Transports.Enable and Mode auto/portal the trip takes the portal
# leg at once when the bot died EscapePortalDeaths times within WindowMs (0 = never at once; the usual
# PortalAfterMs / MaxReissues fallback still applies). Ledger `zone_move` reason death_loop.
AutoWow.DeathLoop.EscapeViaZoneProgression = 0
AutoWow.DeathLoop.EscapePortalDeaths = 3
# V2 (default 0; needs Enable): (a) grind / quest-kill target picks skip creatures standing in the bot's
# live danger areas (self-defence unchanged); (b) the second escalation in the same live area relocates
# even when the zone bracket fits (with EscapeViaZoneProgression: to the level-fitting hub of the lowest
# band, then nearest on the bot's map); (c) after the spirit-healer res of an escalated death the bot takes
# no proactive pull until hp/mana reach AutoWow.Survival.RestGate.MinHpPct/MinManaPct and Resurrection
# Sickness is gone (eats/drinks what it carries), whether or not AutoWow.Survival.RestGate is on.
AutoWow.DeathLoop.V2 = 0
# Hard escape (default 0; needs AutoWow.DeathLoop.Enable; DeathLoopBreaker.h). A "danger zone" is a zone
# whose bracket low (AiPlayerbot.ZoneBracket, else its AreaTable level) is more than WalkZoneMargin above
# the bot. (1) With EscapeViaZoneProgression the escape hub is the nearest one on the bot's map whose
# straight line crosses no danger zone (the bot's own zone excepted), else one on another map, else the
# nearest (replaces the V2 lowest-band pick). (2) AutoWow.Walking.V2 chunks: an endpoint (with
# AutoWow.Travel.Safe also its path points) inside a danger zone other than the bot's own is not
# admissible - the fan steers around, or the leg stalls into the usual reissue / portal fallback instead
# of beelining through. (3) Hard fallback, sampled every 5 s from the player update (dead or in combat
# too) for autonomous open-world non-Oracle bots: the bot's zone bracket low is more than ZoneGap above it,
# or it died Deaths times within AutoWow.DeathLoop.WindowMs with the latest killer KillerGap or more above
# it, and while alive it has not moved MoveYards for StuckMs: it casts its hearthstone (in the bags, off
# cooldown, bound over 100 yd away in a zone that is not a danger zone, out of combat); if that fails to
# start or has not moved it 30 s later, it is portalled to that bind point, else to its faction capital
# (Stormwind / Darnassus / Undercity / Orgrimmar). The portal drops the zone-progression trip (held for
# AutoWow.ZoneProgression.GiveUpCooldownMs), forgets the recorded deaths, logs "[HardEscape]", emits
# ledger zone_move reason hard_escape mode portal (travel_ms = time stuck) and starts CooldownMs. Bots under
# the persistent no-teleport policy never portal. 0 = legacy.
AutoWow.Survival.HardEscape = 0
AutoWow.Survival.HardEscape.WalkZoneMargin = 5
AutoWow.Survival.HardEscape.ZoneGap = 10
AutoWow.Survival.HardEscape.Deaths = 4
AutoWow.Survival.HardEscape.KillerGap = 10
# CorpsePortal: a ghost whose walk to the spirit healer is blocked takes the spirit-healer resurrection there.
AutoWow.Survival.CorpsePortal = 0
# Quests.NeutralNpcs: accept Neutral-faction quest givers/finishers (Mudsprocket, Booty Bay, Ratchet), not only Friendly.
AutoWow.Quests.NeutralNpcs = 0
# ClusterDeaths: this many deaths inside AutoWow.DeathLoop.WindowMs escape whatever the killer level (0 = off).
AutoWow.Survival.HardEscape.ClusterDeaths = 8
AutoWow.Survival.HardEscape.StuckMs = 120000
AutoWow.Survival.HardEscape.MoveYards = 100
AutoWow.Survival.HardEscape.CooldownMs = 900000

# Pull level cap for solo independent bots (PullLevelCap.h; default 0). Grind and quest-objective target
# picks skip creatures whose level (+ElitePenalty for elites) is more than MaxLevelAbove above the bot,
# unless the creature is a quest objective, the bot's hp (and mana) >= HealthyPct and no idle hostile
# stands within AloneYards of it. Self-defence is never capped. Over-cap skips / quest exceptions are
# counted and logged ("[PullCap]") at most once a minute. Read once at world init.
AutoWow.Survival.PullLevelCap = 0
AutoWow.Survival.PullLevelCap.MaxLevelAbove = 2
AutoWow.Survival.PullLevelCap.ElitePenalty = 3
AutoWow.Survival.PullLevelCap.HealthyPct = 80
AutoWow.Survival.PullLevelCap.AloneYards = 15

# Universal rest gate for solo independent bots (RestGate.h; default 0). Grind and quest-kill target picks
# return nothing while hp < MinHpPct, mana < MinManaPct (mana users) or Resurrection Sickness is on; the
# "food" strategy eats / drinks up to the thresholds when the bot carries food / drink (bought with its
# own gold; no cheat food), otherwise the bot just regenerates. Self-defence is never gated. 0 disables a
# threshold. Read once at world init.
AutoWow.Survival.RestGate = 0
AutoWow.Survival.RestGate.MinHpPct = 70
AutoWow.Survival.RestGate.MinManaPct = 60

# Pack-aware pulls for every solo independent bot (PackAvoidPolicy.h; default 0). Each proactive grind /
# quest-kill candidate scores risk = its weight + the weights of the idle creatures friendly to it within
# LinkYards (TacticalPolicy MobWeight: rank x level delta x caster, centi mob-equivalents); a candidate with
# such neighbours and risk above capacity is skipped, the rest sort lone-first. Capacity = the class's
# tactics capacity (tools ready, hp, mana; AutoWow.Tactics.<Class>.* params, loaded with tactics off too) x
# CapacityPct x GearPct, GearPct = main-hand (hunter: ranged) DPS / 0.7 x level, clamped to
# [MinGearPct, 100], for warriors, paladins, hunters, rogues and death knights (100 for the others). With
# AutoWow.Travel.Safe the chunk choice also counts packs by the path at any level (1 + neighbours per mob).
# The AutoWow.Tactics treatment arm keeps its own pack-risk scorer. 0 = legacy.
AutoWow.Survival.PackAvoid = 0
AutoWow.Survival.PackAvoid.LinkYards = 12
AutoWow.Survival.PackAvoid.CapacityPct = 100
AutoWow.Survival.PackAvoid.MinGearPct = 25

# Safe corpse revive for solo autonomous bots (SurvivalRecovery.h; default 0). A ghost resurrects where it
# stands within 39 yd of its corpse: within 60 yd it picks, among the corpse and two rings of 8 points
# (17 / 34 yd), the mmap-reachable spot with the least aggro weight of idle hostiles (elite 6, at or above
# the bot's level 3, lower 1; aggro radius + 5 yd), ties toward the graveyard and away from the killer,
# and reclaims there. No threat-free spot and SpiritDeaths deaths within WindowMs (this one included):
# the spirit healer instead (0 = never). After a corpse revive the bot walks 45 yd off the spot (same
# scoring), then holds the RPG in REST below the AutoWow.Survival.RestGate hp/mana thresholds; after any
# revive no proactive pull until rested (the rest gate's forced rest, flag on or off). 0 = legacy.
AutoWow.Survival.SafeRevive = 0
AutoWow.Survival.SafeRevive.SpiritDeaths = 2
AutoWow.Survival.SafeRevive.WindowMs = 600000
# SafeRevive V2 (default 0; needs AutoWow.Survival.SafeRevive = 1). SpiritDeaths deaths within WindowMs
# take the spirit healer whatever the spot threat (V1 let a zero-threat spot win), and after that res
# the bot relocates once (the death-loop relocation: zone-progression escape hub with
# AutoWow.DeathLoop.EscapeViaZoneProgression, else a flight; logs "[SafeRevive] ... relocate"). Spot
# threat counts every hostile within 60 yd of a spot - idle, in combat, or dead with its respawn due
# within 120 s (at its home position) - not only idle ones in aggro range.
AutoWow.Survival.SafeRevive.V2 = 0

# Safe rest (SurvivalRecovery.h; default 0). (1) A solo independent bot out of combat below the
# AutoWow.Survival.RestGate hp/mana thresholds checks once per rest episode whether a hostile covers it
# (creature aggro radius + 5 yd, as SafeRevive V2: idle, in combat or respawning within 120 s; a hostile
# player 45 yd); if so it walks to the mmap-reachable point (8 bearings at 30 yd, then 60 yd) with the least
# threat, logging "[RestSafe] move ... go|stay" (30 s timeout). Then the RPG holds in REST (the food strategy
# eats) until rested; combat ends the episode. (2) Needs AutoWow.Survival.SafeRevive = 1: the corpse plan
# counts hostile players; after a death to a player (killer or its pet, or a hostile player within 40 yd at
# death) the ghost reclaims only on a threat-free spot, else takes the spirit healer, and the death spot
# becomes a death-loop danger area of PvpDangerYards for PvpDangerMs (needs AutoWow.DeathLoop.Enable; 0 yd =
# none) that RPG grind / quest / travel picks avoid; logs "[RestSafe] pvp_death" / "pvp_plan". 0 = legacy.
AutoWow.Survival.RestSafe = 0
AutoWow.Survival.RestSafe.PvpDangerYards = 80
AutoWow.Survival.RestSafe.PvpDangerMs = 1800000

# Unstick for autonomous bots (SurvivalRecovery.h; default 0). A bot with a travel / quest goal that stays
# within RadiusYards for FrozenMs (0 = rule off), or gives up ReplanExhausted walks with
# intent_replan_exhausted within WindowMs (0 = rule off), casts its hearthstone (in the bags, off cooldown,
# bound over 100 yd away); else, when no mmap probe (8 bearings x 30 yd) gets MinEscapeYards away - a
# navmesh hole - it is portalled to the nearest graveyard (ledger `contaminated` reason unstick_portal);
# else nothing. Every decision logs "[Unstick]" with map/x/y/z/zone/area and starts CooldownMs. 0 = legacy.
AutoWow.Survival.Unstick = 0
AutoWow.Survival.Unstick.RadiusYards = 10
AutoWow.Survival.Unstick.FrozenMs = 300000
AutoWow.Survival.Unstick.ReplanExhausted = 5
AutoWow.Survival.Unstick.WindowMs = 900000
AutoWow.Survival.Unstick.CooldownMs = 600000
AutoWow.Survival.Unstick.MinEscapeYards = 8

# Unstick V2 (UnstickPolicy.h; default 0). Frozen cohort bots (soak-s49..s51: ~20 bots earning ~0 XP):
# - Town trap: with no AutoWow grind spot within 250 yd the search widens in 250-yd bands up to GrindMaxYards.
#   A bot with no grind spot in that reach and no XP for NoXpMs graduates by zone progression (trigger
#   `unstick`; needs AutoWow.ZoneProgression.Enable) to its zone's route, else the nearest hub whose level band
#   fits (walk, then the AutoWow.Transports portal fallback). A quest log with more than LogTrimAbove entries
#   (0 = off) abandons incomplete quests of another zone without progress for LogTrimStaleMs (ledger
#   `abandoned` reason log_trim; logs "[Unstick] ... log_trim").
# - Flight: a graduation flight the bot cannot pay is not chosen; a flight leg that falls back to idle without
#   taking off walks the rest of the trip; taxi refusals log "[Unstick] ... taxi_failed reason=..." at INFO.
# - Combat stall: in combat with no damage dealt / taken / healing for CombatStallMs (0 = off) -> combat
#   stop + threat reset ("[Unstick] combat_stall"); never in a battleground or an instance encounter.
# - Pinned party (needs AutoWow.Party.Enable): a group-quest party disbands (reason `stalled`) after
#   AutoWow.Party.StallMs (0 = off) without quest-log progress, or when its leader's graduation gave up.
# - Instance strand (needs AutoWow.Party.Enable): an unpartied cohort bot alive on an instance map is sent
#   to its hearthstone bind (ledger zone_move reason instance_strand, mode portal). Guids
#   StrandSkipGuidMin..Max (the dungeon probe roster) and running probe parties are left alone.
AutoWow.Unstick.V2 = 0
AutoWow.Unstick.GrindMaxYards = 1000
AutoWow.Unstick.NoXpMs = 1800000
AutoWow.Unstick.LogTrimAbove = 15
AutoWow.Unstick.LogTrimStaleMs = 3600000
AutoWow.Unstick.CombatStallMs = 180000
AutoWow.Party.StallMs = 1200000
AutoWow.Unstick.StrandSkipGuidMin = 72385
AutoWow.Unstick.StrandSkipGuidMax = 72394

# Zone progression for independent AutoWoW bots (Oracle-managed bots and bots with a real master are
# never moved). Every CheckIntervalMs an idle bot graduates when its level >= its zone's
# AiPlayerbot.ZoneBracket max - LevelMargin, or when its quest log had nothing actionable for
# StallChecks consecutive checks, provided a route leaves its zone for its team and level. It then
# travels to the route's hub inn by normal means only: a flight path to an already-known node in the
# destination zone (source node learned at the flight master), else a walk (New RPG go-grind, no
# teleport). At the inn it binds its hearthstone, then walks to and learns the zone's flight master.
# A leg that is not done within TravelTimeoutMs or MaxReissues re-issues is abandoned for
# GiveUpCooldownMs. Ledger `zone_move` per finished/abandoned move. Routes overrides the built-in
# table (ZoneProgressionPolicy.h): ';'-separated "team,from,to,minLevel,maxLevel,map,x,y,z,innEntry,
# crossing" (team 0 any, 1 alliance, 2 horde; crossing 1 = sea between, flight only).
# Known gaps without AutoWow.Transports: Bloodmyst -> Darkshore (Exodar boat), Ghostlands -> EK (orb),
# Teldrassil -> Darkshore without Auberdine known (Rut'theran boat not ridden). Read once at world init.
AutoWow.ZoneProgression.Enable = 0
AutoWow.ZoneProgression.LevelMargin = 2
AutoWow.ZoneProgression.StallChecks = 10
AutoWow.ZoneProgression.CheckIntervalMs = 60000
AutoWow.ZoneProgression.TravelTimeoutMs = 3600000
AutoWow.ZoneProgression.MaxReissues = 8
AutoWow.ZoneProgression.GiveUpCooldownMs = 1800000
# With AutoWow.Transports.Enable = 1 and Transports.Mode auto/portal: a walk leg that spent its stuck budget
# (MaxReissues) or ran PortalAfterMs without reaching the destination zone portals to the hub (zone_move
# mode/leg "portal"). 0 = time rule off. Walk legs follow built-in road points (ZoneProgressionPolicy.h).
AutoWow.ZoneProgression.PortalAfterMs = 1200000
# HighRoutes (default 0): add the L20-60 quest hubs per faction and continent (ZoneProgressionPolicy.h
# DefaultHubs: Alliance EK Duskwood/Wetlands/Southshore -> Rebel Camp/Refuge Pointe -> Booty Bay/Aerie Peak/
# Thorium Point/Nethergarde -> Morgan's Vigil/Chillwind/Light's Hope; Alliance Kalimdor Astranaar/Stonetalon
# Peak -> Nijel's Point/Theramore -> Gadgetzan/Thalanaar/Talrendis -> Marshal's Refuge/Talonbranch/
# Everlook/Cenarion Hold; Horde EK Tarren Mill -> Hammerfall/Grom'gol/Stonard/Kargath -> Booty Bay/
# Revantusk/Thorium Point -> Flame Crest/Light's Hope; Horde Kalimdor Sun Rock/Splintertree/Freewind ->
# Shadowprey/Brackenwall -> Gadgetzan/Camp Mojache/Valormok -> Marshal's Refuge/Bloodvenom/Everlook/
# Cenarion Hold). Each hub is reached from the starter zones and every lower-or-same tier hub zone of
# its faction on the same continent, for bots in its level band; walk/flight as above (same continent).
AutoWow.ZoneProgression.HighRoutes = 0
# Outland (default 0; needs AutoWow.Transports.Enable for the crossings): the L58-70 Outland ladder
# (ZoneProgressionPolicy.h OutlandHubs): Honor Hold/Thrallmar (58-63) -> Telredor/Zabra'jin (60-64) ->
# Allerian/Stonebreaker (62-65) -> Telaar/Garadar (64-67) -> Sylvanaar/Thunderlord (65-68) -> Area 52 and
# Wildhammer/Shadowmoon Village (67-70). Azeroth hub bands stop at 57; every Azeroth hub/source zone leads a
# L58-70 bot to its Hellfire hub through the Dark Portal (TransportCrossingPolicy.h OutlandCrossings: walk,
# or the Ironforge / Orgrimmar / Darnassus Portal to Blasted Lands first). An entry trip still short of
# Hellfire after OutlandPortalAfterMs (0 = time rule off), or out of stuck re-issues, takes the portal
# fallback (Transports.Mode auto/portal). No Northrend ladder yet: a L70 stays in Outland.
AutoWow.ZoneProgression.Outland = 0
AutoWow.ZoneProgression.OutlandPortalAfterMs = 2400000
AutoWow.ZoneProgression.Routes = ""

# Gathering detours for independent questing bots (GatherDetourPolicy.h). A bot that knows Herbalism or
# Mining (e.g. from AutoWow.Professions.Assignments) walks to the nearest visible herb/ore node within
# DetourYards (and DetourMaxDz up/down) whose lock skill it meets (ore needs a mining pick) while out of
# combat and not on a zone-progression trip, errand run, flight or rest, then the stock loot strategy gathers
# it and the RPG status resumes. A node not gathered within DetourTimeoutMs is skipped. Skinning stays
# stock (the "gather" strategy queues skinnable kills). Nothing new is logged (ledger skill_up counts).
AutoWow.Gathering.Detours = 0
AutoWow.Gathering.DetourYards = 60
AutoWow.Gathering.DetourMaxDz = 20
AutoWow.Gathering.DetourTimeoutMs = 45000

# Hunt contracts for independent bots (ContractsPolicy.h). A bot at the RPG Idle choice point with no live
# quest work (DO_QUEST unavailable) is issued a faction contract (issuer faction_board): kill Kills mobs of
# the best spawn cluster within SearchYards - the world-DB spawn with the most normal-rank, attackable,
# level-window ([level - LevelBelow, level + LevelAbove]) spawns within ClusterYards (at least
# MinClusterSpawns; ties nearer, then lower spawn id), skipping the bot's death-loop danger areas and zones
# bracketed more than 3 levels above it. The bot walks to the anchor (no teleport), grinds only the
# contract entries within LeashYards of it, walks back past the leash out of combat, and returns to its
# quest loop when done, expired (TimeoutMs, no credited kill for StallMs, or the anchor became a danger
# area) or abandoned (quest work came back, a zone trip / party took the bot). An errand run pauses both
# clocks. While hunting the bot wanders within LeashYards/2 of the anchor, and zone progression (Level /
# NoQuests triggers) waits for the contract to end. Anchors in water are skipped; lootless mobs only count
# for the team they are hostile to. The anchor then cools down for CooldownMs.
# No reward (no free gold). Ledger `contract` (event 18) per issue and end; [Contracts] log lines.
AutoWow.Contracts.Enable = 0
AutoWow.Contracts.Kills = 15
AutoWow.Contracts.LevelBelow = 3
AutoWow.Contracts.LevelAbove = 1
# LevelGapMin: when > 0, contract mobs top out this many levels below the bot (overrides LevelAbove).
AutoWow.Contracts.LevelGapMin = 0
AutoWow.Contracts.SearchYards = 700
AutoWow.Contracts.ClusterYards = 120
AutoWow.Contracts.LeashYards = 150
AutoWow.Contracts.TimeoutMs = 1200000
# StallMs: no credited contract kill for this long (errand pauses excluded) expires the contract with
# cause stall. 0 = off.
AutoWow.Contracts.StallMs = 480000
AutoWow.Contracts.CooldownMs = 300000
AutoWow.Contracts.MinClusterSpawns = 6

# Profession-house guilds for the persistent cohort (AutoWowGuildsPolicy.h; docs SUPPLY_CHAIN_PLAN.md lane A).
# Houses: ';'-separated "Name:skillId,skillId,...", name ASCII letters only (1-16), in priority order. Each
# house has one guild per team, named by NamePattern ({house}, {team} = Alliance|Horde; at most 24 characters,
# a longer name skips that house with an error at startup). When a cohort bot (CohortGuids: ','-separated
# guid-lows or lo-hi ranges, at most 65536 guids) logs in it joins the house of the lowest-listed house
# holding any skill it has; a bot without a matching skill joins the first house. A bot already in any other
# guild is never moved (logged skip_other_guild). The house is fixed at the first join. A missing house
# guild is created at that login, led by the house rep when online, else by the logging-in bot; guilds are
# found again by name after a restart (the core guild tables are the only state).
# Rep.<House>.<Alliance|Horde>: guid-low of that house's rep (the logistics hub and core guild leader; any
# same-team character, need not be in the cohort, may be offline: it is added as an offline member).
# 0 = the lowest cohort guid in the guild. Leadership moves to the rep when it and the current leader are online.
# Treasury = the guild bank money. TaxPct of the copper a member earns at an errand vendor stop (sell) is
# deposited into its house guild bank (stock deposit; capped by what the bot still holds when the world thread
# runs it). Pay (bank -> member) is refused when the bank is short. Mail helper postage (30 copper per item,
# 30 for a money-only mail) is the sender's, except the rep's is paid from the guild bank.
# No free gold or items. Ledger `guild` (event 19) per join / movement; `trade` action tax; [Guilds] log lines.
AutoWow.Guilds.Enable = 0
AutoWow.Guilds.Houses = "Weavers:197,333;Smiths:186,164,202;Tanners:393,165;Brewers:182,171"
AutoWow.Guilds.NamePattern = "{house} of the {team}"
AutoWow.Guilds.CohortGuids = "62955-63004"
AutoWow.Guilds.TaxPct = 10
# Levy: a house bank short for a payment or postage draws the shortfall from the richest same-team house bank.
AutoWow.Guilds.Levy = 0
# AutoWow.Guilds.Rep.Weavers.Alliance = 0
# AutoWow.Guilds.Rep.Weavers.Horde = 0

# Supply chain V1: the bag production chain (SupplyPolicy.h; docs SUPPLY_CHAIN_PLAN.md lane B). Needs
# AutoWow.Guilds.Enable (houses, reps, treasury, mail). Off = no behavior change (every hook early-outs).
# Roles: a configured house rep (AutoWow.Guilds.Rep.<House>.<Team>) and a configured artisan
# (Artisan.<House>.<Alliance|Horde>, guid-low, 0 = none) never quest, grind, run errands or take contracts:
# they live at their team's capital home (Home.<Team>: "map,x,y,z", default the Stormwind trade district /
# Orgrimmar Valley of Strength mailbox next to the auction house), walk there once (portal fallback when the
# home is on another map or the walk is stuck: [Supply] travel=portal, ledger reason travel), collect their
# mail and hold still. Only the House (default Weavers) artisan crafts in V1; it must be a tailor.
# Overlord (per team, no body, every OverlordMs): bag want = online cohort members' empty bag slots (19-22)
# plus equipped bags smaller than the product (Linen Bag, 6 slots), minus bags already in their bags or
# mailbox; ranked most empty first, ties the lower guid. Order = min(want - finished bags at rep + artisan,
# bags the house linen can make, MaxOrder). Every TickMs (world thread): the artisan's finished bags are
# mailed to the rep, the treasury pays BagPayPct of the bag's vendor value per bag (refused when short) and the
# artisan gets WorkXpPerItem XP per bag (0 = XP-for-level / 20, about a level per 20 bags); the rep mails
# the artisan the linen for the order (below the bag recipe: up to SkillupCloth linen, bolts level the
# skill); the treasury pays the copper the artisan lacks for thread and due trainer spells; the rep mails
# bags to the ranked members (RepXpPerDeal XP per mail, 0 = the same rule); with no want the rep lists bags
# above SurplusKeep at the auctioneer near home (priced as AutoWow.Trade posts) or vendors them.
# Artisan (map thread, at home): learns Artisan.Learn (trainer spell ids; default tailoring ranks + Linen
# Bag) at the tailoring trainer near home with its own money, buys Coarse Thread at the trade-supplies vendor,
# crafts Bolt of Linen Cloth / Linen Bag by the stock spell cast (skill-ups by the stock rules).
# RouteCloth: at the errand sell stop a cohort non-tailor mails its linen / wool / silk to its team's House
# rep (not its own house) instead of selling it, while the rep is online with free bag slots and the rep's
# cloth is under ClothCap. Members equip delivered bags by the stock equip action once they take the mail
# (errand mail stops need AutoWow.Trade.Enable). Mail with items takes the core MailDeliveryDelay between
# different accounts. No free gold or items: all moves are mail, guild bank, vendor, trainer or auction.
# Ledger `supply` (event 20): order|donate|feed|craft|deliver|pay|surplus|xp|refused|travel; [Supply] log.
AutoWow.Supply.Enable = 0
AutoWow.Supply.House = "Weavers"
AutoWow.Supply.TickMs = 30000
AutoWow.Supply.OverlordMs = 300000
AutoWow.Supply.RouteCloth = 0
AutoWow.Supply.ClothCap = 200
AutoWow.Supply.MaxOrder = 6
AutoWow.Supply.BagPayPct = 200
AutoWow.Supply.WorkXpPerItem = 0
AutoWow.Supply.RepXpPerDeal = 0
AutoWow.Supply.SurplusKeep = 4
AutoWow.Supply.SkillupCloth = 40
AutoWow.Supply.HomeYards = 25
AutoWow.Supply.Home.Alliance = "0,-8813,650,95"
AutoWow.Supply.Home.Horde = "1,1660,-4436,18"
AutoWow.Supply.Artisan.Learn = "3911,3912,3913,12181,3755"
# AutoWow.Supply.Artisan.Weavers.Alliance = 0
# AutoWow.Supply.Artisan.Weavers.Horde = 0

# Tiers (lane C, default 0; off = the linen-only chain above, unchanged): tailoring tiers Linen (Bolt of Linen
# Cloth 2963 -> Linen Bag 3755, 6 slots, tailoring 45, Coarse Thread), Wool (Bolt of Woolen Cloth 2964 @75 ->
# Woolen Bag 3757, 8 slots, @80, Fine Thread), Silk (Bolt of Silk Cloth 3839 @125 -> Small Silk Pack 3813,
# 10 slots, @150, Fine Thread + 2 Heavy Leather 4234). The overlord's product = the highest bag tier the
# artisan knows that members want (an empty bag slot or a worn bag with fewer slots) and the house can make
# now, else the highest known wanted tier (materials from the market). With no order open the artisan levels
# on the skill-up recipe: the cheapest known recipe still below grey whose cloth the house holds (at the rank
# cap: none). RouteCloth routes linen, wool and silk, each under its own ClothCap, so a full out-of-reach tier
# cannot starve a usable one. The artisan learns every tier recipe at its trainer once its skill allows (added
# to Artisan.Learn). The tier table is checked against the loaded spells at startup (mismatch: Tiers off).
AutoWow.Supply.Tiers = 0
# Market (default 0; needs Tiers): the bag house rep trades on its capital's faction auction house (never a
# neutral goblin house: that is the future cross-faction channel; with two-side auction interaction on the
# market stays shut). At most one visit per TickMs, at home:
#   sell: cloth tiers out of the artisan's reach above SellKeep units, and any non-house trade goods it holds,
#         priced as AutoWow.Trade posts (undercut the lowest buyout, floor AutoWow.Trade.FloorPct of vendor).
#   buy:  the cloth (and Heavy Leather) the artisan lacks for the product order, else for the skill-up recipe,
#         cheapest per unit first, each unit at most BuyMaxPct of its vendor sell value, at most BuyBudget
#         copper per visit. The house bank pays the rep the planned total, the rep buys out, and copper a
#         rejected bid did not spend goes back to the bank. Won items arrive by mail (the rep's mailbox task).
#   sold: a rep's auction proceeds (taken from the sale mail) are deposited to its house bank.
# Ledger `supply` reasons list|buy|sold (item, count, copper).
AutoWow.Supply.Market = 0
AutoWow.Supply.BuyMaxPct = 400
AutoWow.Supply.BuyBudget = 500
AutoWow.Supply.SellKeep = 60
# ListFloat: copper the house bank keeps on the rep for listing deposits (topped up each TickMs; a sale refunds
# the deposit to the rep, an expiry loses it: a gold sink). Only the sale proceeds (bid - cut) go to the bank.
AutoWow.Supply.ListFloat = 1000

# Product catalog (lane D; SupplyPolicy.h kCatalog). Products: ','-separated lines the overlord runs, each
# TickMs per team: bags (Weavers / tailoring; the chain above, unchanged) and potions (Brewers / alchemy).
# Default "bags" = exactly the chain above. A bad list logs an error and runs bags only. Every `supply` ledger
# row carries "line":"bags|potions|cloth_gear|leather_gear" (appended field). Gear lines: see DemandOnly below.
AutoWow.Supply.Products = "bags"
# Potions line: tiers Minor Healing Potion 118 (spell 2330, learned with alchemy, grey 95; Peacebloom 2447 +
# Silverleaf 765 + Empty Vial 3371), Lesser Healing Potion 858 (spell 2337, alchemy 55, grey 125; Minor Healing
# Potion + Briarthorn 2450), Healing Potion 929 (spell 3447, alchemy 110, grey 175; Bruiseweed 2453 + Briarthorn
# + Leaded Vial 3372). The table is checked against the loaded spells / items at startup (mismatch: line off).
# House.Potions: the house that makes it (default Brewers; must differ from House). Its artisan is
# AutoWow.Supply.Artisan.<House>.<Team> (e.g. Artisan.Brewers.Alliance = guid; 0 = none, the line idles).
# Need (overlord, every OverlordMs): each online cohort member's tier = the highest tier the artisan knows that
# is usable at its level (item RequiredLevel 1 / 3 / 12), else the highest usable one; it wants PotionTarget
# minus its stock of that potion (bags + mailbox). Ranked lowest stock first, ties the lower guid. The product
# = the highest known tier members want that the house can make (else the highest known wanted tier: Market
# buys its herbs). Order = min(want - finished potions at rep + artisan, craftable, PotionMaxOrder).
# Every TickMs (world thread): the artisan's potions (keeping the Minor Healing Potions a Lesser order needs)
# are mailed to the rep; the treasury pays PotionPayPct of the vendor value per potion and the artisan gets
# WorkXpPerItem XP per potion; the rep mails the herbs the order (else SkillupCasts casts of the skill-up
# recipe: the cheapest known non-grey tier the house holds herbs for) still lacks; the treasury pays the copper
# the artisan lacks for vials, due trainer spells and postage; the rep mails potions to the ranked members
# (whole stacks, the last may overshoot; RepXpPerDeal per mail); with no want the rep lists potions above
# PotionSurplusKeep per tier at the auctioneer near home, else vendors them. Market (needs Tiers + Market):
# the Brewers rep buys the herbs the house lacks on the faction AH (BuyMaxPct, BuyBudget; buys only).
# Artisan (map thread, at home): learns Artisan.Learn.Potions (default Apprentice 2275 (level 5), Journeyman
# 2280 (skill 50, level 10), Expert 3465 (skill 125, level 20)) plus Lesser / Healing Potion at the alchemy
# trainer near home (Stormwind 5499, Orgrimmar 3347), buys vials at the vendor near home (Stormwind 1286,
# Orgrimmar 5817), crafts by the stock spell cast (a missing Minor Healing Potion for a Lesser first).
# The artisan must be level 5+ to learn alchemy (no work XP before its first craft; ArtisanMinLevel keeps it an
# adventurer until then).
# Consumer: the stock combat "potions" strategy (every non-battleground bot): critical health
# (AiPlayerbot.CriticalHealth) -> healthstone, else "healing potion" (any potion with a heal effect).
# RouteHerbs: at the errand sell stop a cohort adventurer (any profession: adventurers never craft alchemy)
# mails Peacebloom / Silverleaf / Briarthorn / Bruiseweed to its team's Brewers rep instead of selling them,
# each while the rep holds under HerbCap of it and has free bag slots (held stacks are never vendored).
AutoWow.Supply.House.Potions = "Brewers"
AutoWow.Supply.Artisan.Learn.Potions = "2275,2280,3465"
# AutoWow.Supply.Artisan.Brewers.Alliance = 0
# AutoWow.Supply.Artisan.Brewers.Horde = 0
AutoWow.Supply.RouteHerbs = 0
AutoWow.Supply.HerbCap = 100
AutoWow.Supply.PotionTarget = 5
AutoWow.Supply.PotionPayPct = 200
AutoWow.Supply.PotionMaxOrder = 20
AutoWow.Supply.PotionSurplusKeep = 20
AutoWow.Supply.SkillupCasts = 10
# PotionTiers (lane brewtiers; off by default; off = the potions line exactly as above). Soak S75/S76: the cohort is
# L15-66 but the Brewers artisans (alchemy 57 / 64) know only Minor / Lesser Healing, both from Peacebloom (1 donated
# in S75), while the houses held Bruiseweed + Briarthorn for 19-20 Healing Potions (alchemy 110). On: the line gains
# (checked like the tiers above) Minor Mana Potion 2455 (spell 2331, alchemy 25, grey 105, req 5; Mageroyal 785 +
# Silverleaf + Empty Vial), Lesser Mana Potion 3385 (3173, 120, grey 185, req 14; Mageroyal + Stranglekelp 3820 + Empty
# Vial), Greater Healing Potion 1710 (7181, 155, grey 215, req 21; Liferoot 3357 + Kingsblood 3356 + Leaded Vial), Mana
# Potion 3827 (3452, 160, grey 220, req 22; Stranglekelp + Kingsblood + Leaded Vial) and the Elixir of Wisdom 3383
# (3171, 90, grey 160; Mageroyal + 2 Briarthorn + Empty Vial), a skill-up bridge no member wants: the one trainer recipe
# from 105 (Minor Mana grey) to 110 without Peacebloom (DemandOnly: consumer-less, last resort, sold as `waste`).
# Greater Healing / Mana need Expert alchemy (artisan level 20). Superior Healing / Greater Mana (Artisan alchemy,
# level 35, another trainer) are not in the table. Need: each member wants its best heal tier (req 1 / 3 / 12 / 21) and
# a mana user (max mana > 0) also its best mana tier (req 5 / 14 / 22), each the highest the artisan knows (else the
# highest usable); a better tier of the same family it holds and can use counts as stock. Product: the heal family
# first (craftable, then known wanted), then mana. RouteHerbs also routes Mageroyal / Stranglekelp / Liferoot /
# Kingsblood (each once a recipe using it is within the artisan's skill). Consumer of mana potions: the stock
# "potions" strategy's medium mana -> "mana potion". Log: "[Supply] overlord tiers" per team (item:want/craftable/
# known/surplus for every tier).
AutoWow.Supply.PotionTiers = 0
# RouteRaw (lane G): at the errand sell stop a cohort adventurer mails ore (Copper 2770 / Tin 2771 / Iron 2772) to
# its team's House.Ore rep (default Smiths) and leather (Ruined Leather Scraps 2934 / Light 2318 / Medium 2319) to
# its House.Leather rep (default Tanners) instead of selling them, each while the rep holds under RawCap of it
# and has free bag slots. No line consumes them yet (weapons / leather armor lines come next). Rows: `supply`
# donate with "line":"raw".
AutoWow.Supply.RouteRaw = 0
AutoWow.Supply.RawCap = 100
AutoWow.Supply.House.Ore = "Smiths"
AutoWow.Supply.House.Leather = "Tanners"
# Need-driven production (lane V; owner 2026-09-27: artisans make only useful things, houses supply gear). Off by default.
# DemandOnly: the skill-up recipe (bags with Tiers, catalog lines) is the cheapest whose OUTPUT has a consumer (a bag tier
#   some member wants; a bolt a wanted bag tier or the house's open gear order uses; a potion tier some member is short
#   of), a consumer-less one only as the last resort; while a gear order is open the bag artisan makes no consumer-less
#   skill-up. Orders exist only for named consumers (bag slots, potion stock, gear slots). A surplus sale (AH or vendor:
#   output nobody wanted) is a `waste` row instead of `surplus`; `order` rows name their first consumer and `deliver`
#   rows their receiver ("consumer":guid; 0 = the rep's stock). The bag want already excludes members holding bags as big
#   as the product (worn, loose or in the mailbox).
AutoWow.Supply.DemandOnly = 0
# Gear lines (Products tokens cloth_gear / leather_gear; mail_gear is a data hook without recipes and turns itself off):
#   cloth_gear (House.ClothGear, default Weavers = the bag house: the bag artisan also tailors gear) crafts cloth armor
#   from SupplyPolicy.h kTailorGear (21 trainer-taught recipes, L3-34, from linen / wool / silk bolts + vendor thread /
#   dye); leather_gear (House.LeatherGear, default Tanners; artisan AutoWow.Supply.Artisan.Tanners.<Team>, leather routed
#   with RouteRaw) from kLeatherGear (14 recipes, L5-25, Light Leather -> Medium -> Heavy). The tables are checked
#   against the loaded spells / items at startup (a mismatch turns the line off).
# Need (overlord, every OverlordMs): recipients = AutoWow.Supply.PriorityGuids, the cohort and the squad roster (online
#   bots of the team, no working role). Per recipient and equipment slot, the best known recipe (item level, then spell)
#   whose product the stock "item upgrade" value rates EQUIP / REPLACE at the recipient's level (class / spec weights,
#   armor type), skipping slots a line product is already on its way to (bags or mailbox) and products not above the
#   worn piece's item level. Ranked: PriorityGuids first (its order), then the worst geared (lowest summed equipped item
#   level), ties the lower guid. Order: the top GearMaxOrder needs, per recipe its need count + RepStockPerItem, minus the
#   finished pieces the house (rep + artisan) holds (never more than demand + stock).
# Every TickMs (world thread): the artisan's pieces are mailed straight to their named consumers (re-asked: still an
#   upgrade), the rest to the rep's stock; each piece is paid GearPayPct of its vendor value from the house bank (work
#   XP per piece); the rep mails its stock to the needs left (deal XP). The artisan works the first order entry the house
#   can cast (a bolt / Medium Leather first), learns the line's recipes and ranks (Artisan.Learn.<Key> plus the table) at
#   the line trainer and buys thread / dye at the trade-supplies vendor selling all of them (Stormwind 1347, Orgrimmar
#   5817 / 3364); the rep mails it the cloth / leather (and routed intermediates) the target lacks. Consumer: the stock
#   non-combat "equip upgrades packet action" wears a delivered piece. Rows: `supply` with "line":"cloth_gear" and a
#   consumer field.
AutoWow.Supply.House.ClothGear = "Weavers"
AutoWow.Supply.House.LeatherGear = "Tanners"
AutoWow.Supply.Artisan.Learn.ClothGear = "3911,3912,3913,12181"
AutoWow.Supply.Artisan.Learn.LeatherGear = "2155,2154,3812,10663"
# AutoWow.Supply.Artisan.Tanners.Alliance = 0
# AutoWow.Supply.Artisan.Tanners.Horde = 0
AutoWow.Supply.PriorityGuids = ""
AutoWow.Supply.RepStockPerItem = 2
AutoWow.Supply.GearMaxOrder = 4
AutoWow.Supply.GearPayPct = 200
# Tinkers (lane AA; owner 2026-09-27: every crafting profession lives in a house per faction, artisans make only useful
# things). Products token eng (House.Engineering, default Tinkers; off unless Products names it) runs on the gear line
# runtime above with kEngGear (SupplyPolicy.h): Crafted Light / Heavy / Solid Shot (RequiredLevel 5 / 15 / 30, 200 per
# cast) from Rough / Coarse / Heavy Blasting Powder (routed stone) and Copper / Bronze Bars the artisan smelts itself
# (Mining: Smelt Copper, Tin, Bronze). Heavy / Solid Shot need Engineering 75 / 125, beyond the 60 the anvil-free
# recipes reach: only Light Shot is made until a skill bridge exists. Goggles (RequiredSkill Engineering: no adventurer
# can wear them), scopes (no stock path applies one), bombs / dynamite (no stock AI throws them) are not made.
# Setup: add the house (AutoWow.Guilds.Houses "...;Tinkers:202"; listed after Smiths, engineers stay Smiths members,
#   only the pinned rep / artisan join Tinkers), its reps AutoWow.Guilds.Rep.Tinkers.<Team>, its artisans
#   AutoWow.Supply.Artisan.Tinkers.<Team> (provision-reps.ps1 -Set tinkers), RouteRaw = 1 with House.Ore = "Tinkers" (no
#   Smiths line consumes ore) and House.Stone = "Tinkers" (stone kind 2: Rough 2835 / Coarse 2836 / Heavy 2838; a kind
#   whose house is not a Guilds house is off).
# Need (overlord): a recipient (as the gear lines: PriorityGuids, cohort, squad) that is a hunter with a gun, holds fewer
#   than AmmoTarget bullets (bags + mailbox) and has no stronger ammo loaded (damage min + max; ammo it has none of left
#   counts as none) wants the best known shot usable at its level: one need per recipient per scan, an order unit = one
#   cast (200 shots), RepStockPerItem casts kept at the rep. Deliveries mail whole stacks.
# Consumer: every TickMs the world thread loads (Player::SetAmmo) a gun hunter's strongest house shot from its bags when
#   stronger than its loaded ammo or that ammo is gone ("[Supply] ammo load"); the stock ammo equip never fires
#   (ItemUsageValue::QueryItemUsageForAmmo answers NONE for every class).
# Artisan: learns Engineering + Mining ranks (Artisan.Learn.Engineering) and the table recipes at the engineering trainer
#   (Stormwind 5518, Orgrimmar 11017) and the mining trainer (Stormwind 5513, Orgrimmar 3357; the second trainer: the
#   one teaching the first learn spell the first does not); both stand beyond the 400-yard station radius, so
#   StationYards.Engineering widens the search for this line. A smelt (spell focus: forge) is cast on a trip to the forge
#   nearest home (Stormwind 24746 at 386 yards, Orgrimmar 1685 at 152 yards), where it keeps casting the order while it
#   can. Pay per piece: GearPayPct of its sell value, shot (sell value 0) of its vendor lot price.
AutoWow.Supply.House.Engineering = "Tinkers"
AutoWow.Supply.House.Stone = "Tinkers"
AutoWow.Supply.Artisan.Learn.Engineering = "4039,4040,4041,12657,2581,2582,3568,10249"
AutoWow.Supply.StationYards.Engineering = 520
AutoWow.Supply.AmmoTarget = 1000
# GearBootstrap (lane bootstrap, soak S53-S59: the Tanners artisans sat at leatherworking 1 and the Tinkers artisans
# never trained engineering). Off by default; off = the gear lines exactly as above.
#   Need: when no need of a gear line has a recipe its artisan knows, the overlord scans the recipes it can reach (not
#   known, recipe skill up to its rank's cap, or the next rank's when its level trains it: 75 / 150 / 225 at levels
#   5 / 10 / 20 ...). The first such need only skill blocks (recipe above the artisan's skill; lower ones it learns at
#   the trainer) gets a skill-up order: SkillupCasts casts of the cheapest known recipe of the line's own skill still
#   below grey, not already held SkillupCasts deep by the house; the order names that need's recipient (DemandOnly).
#   The pieces go to the rep's stock, as any order's. "[Supply] gear bootstrap" logs every decision.
#   Table: leather_gear adds its starters (learned with Leatherworking): Light Leather from routed Ruined Leather Scraps,
#   Handstitched Leather Boots / Cloak (the only casts below Handstitched Leather Pants, skill 15).
#   Stations: a gear line without StationYards.<Key> searches 600 yards (the Engineering / Mining trainers stand past 400).
AutoWow.Supply.GearBootstrap = 0
# EngGuns (lane tinkers2, soak S60: the Tinkers artisans trained engineering but had no consumer: the cohort's gun
# hunters hold 1000 vendor Heavy Shot, its bow / crossbow hunters have no Guns skill, and engineering stopped at 60,
# below Heavy Shot's 75). Off by default; off = the eng line exactly as above. Needs Products eng; the climb from
# skill 1 needs GearBootstrap.
#   Table: + Handful of Copper Bolts, Copper Tube, Rough Boomstick (RequiredLevel 5, item level 10) and Bronze Tube,
#   all trainer-taught (skill 30 / 50 / 50 / 105), all cast at an anvil with a Blacksmith Hammer in the bags.
#   Need: Rough Boomstick is ordered only for a recipient it upgrades (the gear lines' need: the stock "item upgrade"
#   value on the ranged slot, item level above the worn piece, the Guns skill); worn, a hunter's bullet need follows.
#   Skill: Copper Tube / Rough Boomstick (grey 110) bridge engineering 60 -> 75 (Heavy Shot), Bronze Tube (grey 155)
#   110 -> 125 (Solid Shot): GearBootstrap skill-up casts toward a blocked need.
#   Stations: the anvil nearest home (Stormwind 23303 at 389 yards, Orgrimmar 1684 at 150); a cast needing it is a
#   trip there (task 15), as a smelt is a forge trip. The line vendor sells Weak Flux, Wooden Stock and the hammer
#   (Stormwind 1286, Orgrimmar 5817); the artisan buys one hammer when a known recipe needs it.
#   Dropped: Deadly Blunderbuss (Medium Leather routes to the Tanners; no vendor sells the Arclight Spanner),
#   Silver-plated Shotgun (Silver Bar, a wool-cloth gizmo), Lovingly Crafted Boomstick / Moonsight Rifle (schematics).
AutoWow.Supply.EngGuns = 0
# AutoWow.Guilds.Rep.Tinkers.Alliance = 0
# AutoWow.Guilds.Rep.Tinkers.Horde = 0
# AutoWow.Supply.Artisan.Tinkers.Alliance = 0
# AutoWow.Supply.Artisan.Tinkers.Horde = 0
# Outfit (owner ruling 2026-09-26): the house treasury funds its members' starter equipment. No free gold or items:
# the grant is a real guild bank -> member transfer, the tool is bought at a vendor. Needs AutoWow.Errands.Enable.
# A cohort bot (AutoWow.Guilds.CohortGuids) that knows Mining (186) / Skinning (393) and holds no pick / knife
# (bags or equipped) has an errand need "tool" (needs bit 2048): soft, and alone it starts a town run at most once
# per OutfitCheckMs. At a town whose vendors sell it (Mining Pick 2901 / Skinning Knife 7005, trade / mining /
# leatherworking supplies) the bot buys one with its own gold after its trainer stops (a planned Mining / Skinning
# learned there gets its tool in the same run). A tradeskill trainer with an unaffordable rank of a planned primary
# (AutoWow.Professions.Assignments) is errand work too. On arrival, when the bot's money is short of its tools plus
# those ranks (+50 copper), it asks its house for a grant; every AutoWow.Supply.TickMs the world thread pays the
# pending requests, lowest level first (ties the lower guid), each shortfall whole or not at all, from the bot's
# house bank (AutoWow.Guilds.Levy draws a short bank from the richest same-team house), capped at OutfitMaxCopper
# per bot per character level and OutfitBudgetPerHour per team per game hour (caps in memory: reset on restart).
# The trainer / tool stop waits for its pending request. Rows: `guild` grant (or refused op "grant" when the bank
# is short); `supply` "line":"outfit": outfit (a tool bought, item + copper), refused op grant_bot_cap /
# grant_team_budget (item 0) or outfit (the purchase failed); errand done bit 256 = a tool bought.
AutoWow.Supply.Outfit = 0
AutoWow.Supply.OutfitCheckMs = 600000
AutoWow.Supply.OutfitMaxCopper = 500
AutoWow.Supply.OutfitBudgetPerHour = 5000
# Weapon / food floors (lane AN; soak S62-S65: 3.55 cohort deaths per bot-hour, rogues 9.5 with starter weapons at
# L27-43; 44 of 50 bots carried no food, 40 no drink; 48 errands had gear due and 2 bought it). OutfitGear (needs
# AutoWow.Supply.Outfit and AutoWow.Errands.Enable; the weapon floor also AutoWow.Gear.Upgrades for the vendor catalog):
# a main hand (a hunter's bow / gun / crossbow too) below AutoWow.Gear.FarBelowPct of the level curve (0.7 DPS x
# level, the world DB vendor weapons) is an urgent errand need "gear" once per level, whatever the purse. At the town
# the bot picks the best upgrade its own gold buys when that clears the floor, else the cheapest upgrade that does
# within its gold + grant room, else the best upgrade within gold + room (the stock item-upgrade scorer's offers); the
# floor weapon skips the trainer / food reserve and is bought before any trainer. Every errand also tops food up to
# AutoWow.Errands.FoodTarget and drink (mana users, a mage too) to WaterTarget, skipping the trainer reserve. What
# own gold cannot pay of the floor weapons + food / drink joins the Outfit grant request (the house treasury pays;
# the weapon / buy stops wait for it). The per-bot per-level cap grows by OutfitGearCopper x level^2 (25: L20 1g,
# L36 3g24s, L40 4g; cheapest vendor weapon L20 58s, L30 1g57s, L40 3g57s), the team's hourly budget by
# OutfitGearBudgetPerHour. Rows: `supply` "line":"outfit" weapon_floor / food_floor (item + copper paid), grant (the
# treasury paid: item 0, copper), refused op weapon_floor (the buy failed); errand done bits 512 = a floor weapon
# bought, 1024 = food / drink bought; "[Outfit]" log lines weapon_floor plan / floor copper.
AutoWow.Supply.OutfitGear = 0
AutoWow.Supply.OutfitGearCopper = 25
AutoWow.Supply.OutfitGearBudgetPerHour = 50000
# Artisan upkeep (lane F; soak-s45-full-r1). Every role bot (rep and artisan) picks its mailbox only for a mail it
# can take something from (its money, or an item its bags can store). ArtisanFreeSlots (0 = off): a crafting
# artisan (bag house / catalog line) under this many free bag slots makes room at its next decision: unsellable
# junk (SellPrice 0, not a material / product of its line, not wanted by a quest in its log, not the hearthstone,
# a profession tool, a fishing pole, a container or a not-destroyable item) is destroyed, ascending item guid, only
# for the slots the sales below cannot free; the sellable junk is sold at the vendor near home (a `supply` junk
# row, op vendor; each destroyed stack op destroy + a "[Supply] junk" log line); still short with no bag worn it
# buys a Small Brown Pouch 4496 (500 copper, general goods near home: Stormwind 1285, Orgrimmar 3369) with its own
# gold, asking an Outfit grant for a shortfall (needs AutoWow.Supply.Outfit), and wears it (`supply` outfit row).
# A craft whose product has no room (no free slot, no partial stack) is skipped and makes room (one slot at least).
# ArtisanMinLevel (0 = off): a configured artisan below this level is an apprentice, an ordinary cohort adventurer
# (quests, errands, parties; the chain treats it as offline: no feed / pay / deliveries); at the level (out of any
# dungeon) it goes home and trains ("[Supply] apprentice ... graduated"). Apprentice Alchemy needs level 5.
# Configured artisans are pinned to their house guild at login like reps (AutoWow.Guilds): a pinned rep / artisan
# in another of our house guilds (not its leader) is moved (`guild` moved row); other guilds are never touched.
AutoWow.Supply.ArtisanFreeSlots = 4
AutoWow.Supply.ArtisanMinLevel = 10
# Rep storage (lane T; soak-s48-full-r1: the Alliance Weavers rep, level 3 with 16 backpack slots, refused every
# cloth donation and bag delivery; its box held 120 emptied mails, see AutoWow.Trade.DeleteEmptyMail). RepStore (a
# bug fix, on by default; 0 = the previous chain): every configured rep wears its own loose general bags in its empty
# bag slots each tick, biggest first ("[Supply] rep bag"); the bag house ranks the reps before every member wanting
# bags (the bag-house rep keeps its share and wears it); a rep whose bags are over 75% full walks to the banker near
# home (Stormwind 2455, Orgrimmar 3318) and banks its trade goods beyond RepKeep units per item; a rep under RepKeep
# of a house material (the bag tiers' or its line's) takes it back from its bank while its bags stay at most 75% full
# ("[Supply] bank"); banked units count toward ClothCap / HerbCap / RawCap. Donors skip a rep holding RepMailCap mails
# or more (the core refuses a mail at 100); a mail refused for a full box is a `supply` refused row op mailbox_full.
# The artisan -> rep delivery and the rep -> artisan feed carry every tier / item in one mail (at most 12 stacks).
AutoWow.Supply.RepStore = 1
AutoWow.Supply.RepMailCap = 80
AutoWow.Supply.RepKeep = 60

# Supply-chain throughput (lane U; soak-s49-full-r1: the Horde tailor made 187 crafts in 2 h once fed, but the chain
# delivered a handful of bags: material trickle, an empty faction AH and 4-5 mail hops). All off by default.
# DirectRoutes: donors (cohort adventurers and the squad) mail a house material straight to the house ARTISAN while it
#   works at home with more free bag slots than ArtisanFreeSlots and fewer than RepMailCap mails, for the materials it
#   uses now (the bag product / skill-up tier's cloth; a line's routed reagents it can use at its skill); the room is
#   the house stock (rep + artisan) under ClothCap / HerbCap. Everything else, and every material while the artisan is
#   away, full or an apprentice, goes to the rep as before. The artisan mails finished bags / potions straight to the
#   ranked members (the rep's own RepStore share and the rest still ship to the rep); each is paid from the house bank
#   and XP'd as before, and the rep earns its deal XP. `supply` donate / deliver rows name the receiver in `to`.
# MailPickup: a cohort member with mail it can take walks to a mailbox within MailPickupYards and collects it (not
#   only on errand runs, "[Market] pickup"); a delivered bag / potions mail from its house is an errand need (bit
#   4096 `mail`, soft; alone it starts a town run at most once per MailRunMs ms; towns list mailboxes with
#   AutoWow.Trade.Enable on).
AutoWow.Supply.DirectRoutes = 0
AutoWow.Supply.MailPickup = 0
AutoWow.Supply.MailPickupYards = 40
AutoWow.Supply.MailRunMs = 1800000

# Craft flow (lane craftflow; soak-s75-full-r1, 2.3 h: gathering boomed, crafting made 26 casts). All off by default; off =
# the chain exactly as above.
# RouteBagExtra (needs Tiers): at the errand sell stop a cohort adventurer mails a bag tier's extra reagent (Small Silk
#   Pack: Heavy Leather 4234, 2 per pack) to the bag house rep, within the room of the packs members want that the house
#   cloth makes (min(want, packs from the silk / bolts held) x 2 - Heavy Leather held; known recipe, rep ready). S75:
#   92 / 86 packs wanted, 214 / 209 silk held, 1 / 0 Heavy Leather: no silk pack was made. Rows: `supply` donate
#   "line":"bags" item 4234.
# GearStockSell: a gear line rep (cloth_gear / leather_gear / eng house) vendors its finished pieces beyond RepStockPerItem
#   per recipe (the lowest item guids stay; shot sells for 0 and stays) at the vendor near home. S75: the Horde Tanners
#   rep's 40 slots held 28 unwanted pieces (bootstrap skill-ups, rep stock), 37 mails with 95 Light Leather sat untaken
#   and its artisan (25 Fine Leather Belt orders) was never fed. Rows: `supply` waste (DemandOnly; else surplus) op
#   vendor, item 0, count = pieces; "[Supply] gear stock sale" log.
# GearSkillupRestock (needs GearBootstrap): when every skill-up option is stocked (house holds SkillupCasts casts), the
#   cheapest known non-grey one anyway, ordered past the artisan's own finished units. S75: both Tinkers artisans sat at
#   engineering 46 / 49 (Rough Boomstick needs 50) holding 10 Copper Bolts each, the reps 20 casts of Light Shot:
#   skillup=0 in all 96 bootstrap scans. "[Supply] gear bootstrap restock" log.
AutoWow.Supply.RouteBagExtra = 0
AutoWow.Supply.GearStockSell = 0
AutoWow.Supply.GearSkillupRestock = 0

# Market (lane U). RandomSellers: a random bot (not cohort, not a role) that is idle / wandering within SellerYards of
#   a faction auctioneer (every SellerScanMs) walks there and lists its own `ah`-usage loot (trade goods, reagents,
#   gems, greens; not soulbound) with the AutoWow.Trade pricing (undercut the lowest buyout, floor FloorPct of vendor,
#   else PriceMultPct; deposits from its own money; ledger `trade` post rows); near a mailbox it takes its mail (sale
#   money, expired listings, COD payments). MailOrders: every AutoWow.Supply tick each house rep publishes buy orders
#   for what its lines lack now (its Market wants; item, units, AutoWow.Supply.BuyMaxPct of the vendor value per unit)
#   within its house bank less the COD it already owes; a random seller at a mailbox mails its own matching stacks to
#   the rep as cash on delivery at the order price (whole stacks, never over the order; `trade` cod_sell); the rep
#   takes them at its mailbox, the house bank topping its purse up to the COD (a guild pay row; `trade` cod_buy), or
#   returns what it does not expect from that seller or cannot afford (`trade` cod_return). SellerCapPerHour bounds
#   each random bot's listings + COD mails per game hour. Needs AutoWow.Supply.Enable (and Tiers for the bag house).
AutoWow.Market.RandomSellers = 0
AutoWow.Market.MailOrders = 0
AutoWow.Market.SellerCapPerHour = 6
AutoWow.Market.SellerScanMs = 60000
AutoWow.Market.SellerYards = 120

# Gatherer squad (lane G; SquadPolicy.h; docs/SUPPLY_CHAIN_PLAN.md "Gatherer squad"). Enable: a per-team roster
# (Alliance / Horde: ','-separated guids or lo-hi ranges, at most 10 per team, sorted; the guids must also be in
# AutoWow.Guilds.CohortGuids for routing) puts material demand before levelling. Needs AutoWow.Supply.Enable for
# demand (RouteCloth / RouteHerbs / RouteRaw decide which materials are demanded) and AutoWow.Gathering.Detours
# for node gathering. The roster is one core party (ledger `party` why "squad"; leader = the lowest online guid;
# no follower mode; exempt from cohort formation and the keep rules). Every TickMs (world thread) per team:
# demand = the supply routing rooms of the materials the houses can use now (at least MinDemand units), largest
# first; the first material the squad can work (cloth: anyone; herb / ore: a member's herbalism / mining (with a
# pick) meets the node lock; leather: a skinner (with a knife) meets the corpse's skinning skill) gets the
# nearest source cluster (at least MinClusterSpawns sources within ClusterYards, within SearchYards of the
# leader on its map): creature sources are loot-table sources (MinDropPct) whose max level <= squad average
# level + LevelAbove (min level >= average - LevelBelow; 255 = grey allowed); the anchor is skipped when
# cooling (CooldownMs after the last stint there), in a death-loop area, in water, or in a zone bracketed above
# average + ZoneLevelMargin. A stint: the members walk to the anchor (the leader waits until everyone alive on
# its map is within TogetherYards), then hunt only the source entries (grey included; node stints: anything)
# and gather within LeashYards; errand runs deliver through the routing above. It ends when the members hold
# the wanted units more than at the start (done), the demand is gone, the anchor turns dangerous, the leader's
# walk is stuck, nobody stands on the anchor map, or after StintMs. While a stint runs (and until a search finds
# no workable demand) zone progression holds the members in their zone unless it is dangerous for them.
# Ledger `squad` (event 22): stint | gather (cause done|demand_met|danger|stuck|empty|timeout) | deliver | hold |
# release (cause no_demand|no_source).
AutoWow.Squad.Enable = 0
AutoWow.Squad.Alliance = ""
AutoWow.Squad.Horde = ""
AutoWow.Squad.TickMs = 30000
AutoWow.Squad.StintMs = 1800000
AutoWow.Squad.LevelAbove = 1
AutoWow.Squad.LevelBelow = 255
AutoWow.Squad.ZoneLevelMargin = 3
AutoWow.Squad.SearchYards = 2500
AutoWow.Squad.ClusterYards = 120
AutoWow.Squad.MinClusterSpawns = 5
AutoWow.Squad.LeashYards = 150
AutoWow.Squad.TogetherYards = 60
AutoWow.Squad.MinDemand = 5
AutoWow.Squad.MinDropPct = 5
AutoWow.Squad.CooldownMs = 600000
AutoWow.Squad.SearchRetryMs = 60000

# Gatherer squad level window (lane AL squadzone; SquadPolicy.h "AutoWow.Squad.LevelWindow"; needs AutoWow.Squad.Enable).
# soak-s62-full-r1: 91 of 103 squad deaths were three members away from any anchor (a L23 walking to the anchor
# through Alterac Mountains, a L22 dying on its walk through the Wetlands, a L19 on another continent left without
# grind targets by the stint filter). LevelWindow 0 = off (unchanged behaviour). LevelWindow > 0 (suggested 2):
#   (1) an anchor's zone bracket low <= squad average level + LevelWindow (replaces ZoneLevelMargin), the leader's
#       straight line to it crosses no zone bracketed above that, and a death-cluster zone (4) is skipped while it
#       cools;
#   (2) a member whose straight line to the anchor crosses a zone bracketed above its level + LevelWindow (its own
#       zone excepted), or with DeathCluster deaths within AutoWow.DeathLoop.WindowMs (needs AutoWow.DeathLoop.Enable),
#       is benched for the stint: its own loop runs, the leader does not wait for it, zone progression does not hold
#       it, the stint target filter does not narrow its grind targets (ledger `squad` bench, cause route|deaths);
#   (3) a member on another map than the anchor gets no stint target filter;
#   (4) a member within LeashYards of the anchor with DeathCluster recent deaths ends the stint (cause danger) and
#       the anchor zone is skipped by the search for DangerZoneMs.
AutoWow.Squad.LevelWindow = 0
AutoWow.Squad.DeathCluster = 3
AutoWow.Squad.DangerZoneMs = 3600000
#   (5) a bench lasts BenchMs (not re-evaluated, outlives stint ends); a newly benched member takes one death-loop
#       escape trip to a level-fitting hub (needs AutoWow.DeathLoop.EscapeViaZoneProgression and
#       AutoWow.ZoneProgression.Enable); the lowest unbenched member leads; more than half of the online members
#       benched ends the stint and holds the search (squad gather / release cause benched).
AutoWow.Squad.BenchMs = 1800000

# Dungeon completability probe (lane P; DungeonProbePolicy.h / DungeonProbeRuntime.cpp). TEST INSTRUMENTS, not
# faction members (owner ruling 2026-09-27): magic level, gear, spec, teleports and resurrections are allowed for
# the probe parties and never for cohort / role / squad bots. Parties: ';'-separated "name:guid,guid,..." (1..5
# guids, name [A-Za-z0-9_-]). Every guid must also be in AutoWow.FixtureGuids and must not be in the cohort range,
# AutoWow.OracleRuntime.BotGuids, AutoWow.Guilds.CohortGuids, a supply role or a squad roster, else the whole party
# is refused at world init. Accepted probe guids are excluded from party formation / orphan disband, contracts and
# guild houses even with Enable = 0. Per party, every TickMs (world thread), the Dungeons queue (map ids) is looped
# Loops times (0 = forever): Prepare (offline members are logged in; level = recommended max (built-in classic
# table, Levels = "map:level,..." overrides / extends it) + LevelOver; fixture factory with the fixed spec (warrior
# prot, priest holy, mage frost, rogue combat, hunter bm) and exact-quality gear from Quality down to uncommon;
# hunter pet; debuffs removed; a fresh party led by the tank) -> Enter (probe teleport to the entrance trigger's
# instance-side point, leader first) -> Inside (the dungeon navigator leads; a dead member is resurrected at the
# leader after ReviveGraceMs without party combat; a wipe resurrects everyone at the entrance and continues the
# instance, MaxWipes wipes end it as wiped_out; no leader progress for StuckMs (StuckYards) is a stuck event,
# StuckLimit of them end it; RunTimeoutMs after entry = timeout) -> Exit (homebind, disband, unbind) -> next.
# Ledger `dprobe` (event 24): entered | boss_killed | wiped | revived | stuck | run (one per run: end =
# completed|abandoned|stuck|timeout|wiped_out|enter_failed|prepare_failed). Reducer: scripts/dungeon-probe-report.py.
AutoWow.DungeonProbe.Enable = 0
AutoWow.DungeonProbe.Parties = ""
AutoWow.DungeonProbe.Dungeons = "36,43,389,47,48,90,129,70,109,209,230,329,349,429"
AutoWow.DungeonProbe.Levels = ""
AutoWow.DungeonProbe.LevelOver = 2
AutoWow.DungeonProbe.Quality = 4
AutoWow.DungeonProbe.MaxWipes = 3
AutoWow.DungeonProbe.RunTimeoutMs = 3600000
AutoWow.DungeonProbe.StuckMs = 300000
AutoWow.DungeonProbe.StuckYards = 10
AutoWow.DungeonProbe.StuckLimit = 2
AutoWow.DungeonProbe.ReviveGraceMs = 30000
AutoWow.DungeonProbe.PrepareTimeoutMs = 600000
AutoWow.DungeonProbe.EnterTimeoutMs = 180000
AutoWow.DungeonProbe.ExitTimeoutMs = 120000
AutoWow.DungeonProbe.Loops = 1
AutoWow.DungeonProbe.TickMs = 1000

# Real crossings for zone progression (needs AutoWow.ZoneProgression.Enable; TransportCrossingPolicy.h).
# A route across water / a continent with no known flight path runs a chain: walk -> crossing -> walk
# -> ... -> hub. Travel objects: walk into an areatrigger (Darnassus -> Rut'theran) or use a teleport
# GameObject (Silvermoon Orb of Translocation -> Undercity). Transports (boats, zeppelins): wait on the
# dock, walk onto the deck while the ship is docked (the core makes the bot a passenger), stay aboard,
# step off at the destination dock. Mode real|portal|auto (owner ruling 2026-09-24): portal relocates
# the bot dock -> dock with no ship (ledger leg "portal"); auto rides, and switches a crossing to the
# portal after AutoPortalAfterFailures failed rides (step past StepTimeoutMs or off the deck mid-sea).
# ModeOverrides: ';'-separated "transportEntry=real|portal|auto". Crossings overrides the built-in
# table: ';'-separated rows "team,from,to,seq,via,object,map,x,y,z,stopX,stopY,exitMap,exitX,exitY,
# exitZ,exitStopX,exitStopY" (via 0 areatrigger, 1 gameobject, 2 transport). The flag also adds the
# crossing-only routes (Bloodmyst/Wetlands/Ghostlands/Barrens) to the zone-progression table. Ledger
# `zone_move` gains "legs":[[walk|flight|travel_object|transport|portal, ms], ...]. Read once at init.
AutoWow.Transports.Enable = 0
AutoWow.Transports.Mode = "auto"
AutoWow.Transports.ModeOverrides = ""
AutoWow.Transports.AutoPortalAfterFailures = 2
AutoWow.Transports.ApproachYards = 5
AutoWow.Transports.ExitYards = 60
AutoWow.Transports.DockedYards = 8
AutoWow.Transports.JoinYards = 300
AutoWow.Transports.StepTimeoutMs = 900000
AutoWow.Transports.Crossings = ""

# Town runs for independent bots (ErrandsPolicy.h; random bots are kept up by cheats instead). Every
# CheckIntervalMs a bot assesses its needs: bags >= BagSoftPct used (BagUrgentPct urgent), average
# equipped durability < DurabilitySoftPct (DurabilityUrgentPct urgent), food/water/ammo/reagent below
# *Low for its class and level (a hunter with no ammo is urgent), a class-trainer visit due (two levels,
# gold for a rank), a profession rank due (planned bots), hearthstone bound outside the zone, the zone's
# flight path unknown. Any urgent need, or two soft ones that the chosen town can serve, starts a run to
# the cheapest friendly town (innkeeper + repair NPC + food/water vendor within TownRadius, flight
# master optional): hearthstone when bound there, ready and farther than HearthMinYards; else a known
# flight path; else a walk up to MaxWalkYards (no teleport). At the town, one batch: sell junk, repair,
# restock up to *Target (best tier sold for the level), train, bind the hearthstone, learn the flight
# path, all with real gold (unaffordable items/ranks skipped and logged); then back to the pre-run spot.
# Ledger `errand` (event 14) per run. CooldownMs between runs. The town table is built once at world
# init with the flag on.
AutoWow.Errands.Enable = 0
AutoWow.Errands.CheckIntervalMs = 60000
AutoWow.Errands.CooldownMs = 900000
AutoWow.Errands.BagSoftPct = 70
AutoWow.Errands.BagUrgentPct = 90
AutoWow.Errands.DurabilitySoftPct = 50
AutoWow.Errands.DurabilityUrgentPct = 25
AutoWow.Errands.FoodLow = 5
AutoWow.Errands.FoodTarget = 20
AutoWow.Errands.WaterLow = 5
AutoWow.Errands.WaterTarget = 20
AutoWow.Errands.AmmoLow = 200
AutoWow.Errands.AmmoTarget = 1000
AutoWow.Errands.ReagentLow = 1
AutoWow.Errands.ReagentTarget = 5
AutoWow.Errands.TownRadius = 180
AutoWow.Errands.HearthMinYards = 800
AutoWow.Errands.MaxWalkYards = 4000
AutoWow.Errands.TravelTimeoutMs = 1200000
# AuctionDetourMs: with AutoWow.Trade.Enable, a town with an auctioneer is costed this many ms cheaper, and
# the nearest one on the map is always a candidate, so town runs reach an auction house. 0 = off.
AutoWow.Errands.AuctionDetourMs = 0
# SellTradeGoods: at the sell stop also sell white/grey trade goods no profession of the bot needs.
AutoWow.Errands.SellTradeGoods = 0

# Gear upgrades for independent bots (GearUpgradePolicy.h; default 0; the vendor part needs
# AutoWow.Errands.Enable = 1). Real gold only, no free items. Once per level, with MinBudget gold beyond
# the reserve (a class-trainer rank + 1 silver per level for food), gear is a soft errand need; urgent when
# the main hand's DPS is below FarBelowPct of 0.7 x level. At the town the bot shops the plain-gold white /
# green weapons and armor that the stock "item upgrade" value rates an equip for it: the highest-DPS main
# hand (off hand for dual wielders) with >= UpgradePct of the equipped DPS, then armor for EMPTY slots
# (head, shoulders, chest, waist, legs, feet, wrists, hands, back; the off hand without a dual wield / two-
# hander), each piece <= ArmorSpendPct of what is left, at most MaxArmorBuys; the stock equip action puts
# them on. Ranged slots are not shopped. Also: a quest choice reward with no equip upgrade among the
# choices takes the one that sells for most. Logs "[Gear]"; errand ledger done bit 128, needs bit 1024.
AutoWow.Gear.Upgrades = 0
AutoWow.Gear.UpgradePct = 150
AutoWow.Gear.FarBelowPct = 50
AutoWow.Gear.ArmorSpendPct = 25
AutoWow.Gear.MaxArmorBuys = 4

# Auction-house gear upgrades for independent bots (GearUpgradePolicy.h; default 0; needs AutoWow.Trade.Enable and
# AutoWow.Errands.Enable). Real gold only. At an errand's auctioneer stop the bot buys out up to AuctionMaxBuys (<= 4)
# listings of others that the stock "item upgrade" value rates an equip for it and that raise the item level of their
# slot: slot by slot (main hand, a hunter's ranged, off hand, chest, legs, head, shoulders, hands, feet, waist, wrists,
# back, other ranged, neck, rings, trinkets), per slot the most ilvl gain per copper, each <= level^2 x AuctionPriceMult
# copper, all within the money less the repair bill, a class-trainer rank and a food reserve. This replaces the one
# cheapest upgrade AutoWow.Trade buys. The mail stop brings them, the stock equip action puts them on at the errands'
# end. A bot whose average equipped item level is under AuctionIlvlPct of (level + 5), with AuctionMinSpendPct of one
# item cap to spend, makes an auction-town run once per level. Logs "[AhGear]"; trade ledger reason ah_gear (+ gain);
# errand ledger needs bit 8192, done bit 2048.
AutoWow.Gear.AuctionUpgrades = 0
AutoWow.Gear.AuctionMaxBuys = 3
AutoWow.Gear.AuctionPriceMult = 20
AutoWow.Gear.AuctionIlvlPct = 75
AutoWow.Gear.AuctionMinSpendPct = 50

# Gear flow among the gear recipients (GearUpgradePolicy.h; default 0; the cohort, AutoWow.Supply.PriorityGuids and
# the squad roster, no working roles). Supply gear lines deliver tradeable pieces only (a bound piece an artisan wore
# no longer jams its line). Every FlowTickMs, on the world thread, each loose tradeable weapon / armor piece of
# FlowMinQuality+ (1 = white) that the stock "item upgrade" value rates no upgrade for its holder is mailed (holder
# pays postage) to the same-faction recipient it upgrades most: item level over the worn piece of that slot, the stock
# value confirming; at most FlowMaxMails per pass, one per recipient. The flow mail counts as a supply mail for
# AutoWow.Supply.MailPickup; the stock bag scan wears it. Logs "[GearFlow]".
AutoWow.Gear.Flow = 0
AutoWow.Gear.FlowTickMs = 60000
AutoWow.Gear.FlowMaxMails = 10
AutoWow.Gear.FlowMinQuality = 1

# Self-sufficiency secondary professions for cohort adventurers (SelfCraftPolicy.h; default 0). Not supply
# reps / artisans, not Oracle-managed bots. Learning is the stock errand trainer stop (the learn filter admits
# AutoWow.Professions.Secondaries, default 129,185,356; ranks and recipes cost real gold). With the flag on,
# out of combat: FirstAid - below UseHpPct health with no attacker the bot applies its best usable bandage
# (before the rest-gate food); it crafts bandages from its own linen / wool / silk up to BandageTarget, and
# BandageCloth units of the cloth of the bandage it works toward are never sold (whole stacks). Cooking - it
# cooks its own beast meat (Charred / Spiced Wolf Meat .. Spider Sausage, trainer recipes to 225) at a cooking
# fire, lighting a Basic Campfire (learned with Cooking, no reagent) when none is near: food while its food
# stock is under FoodTarget, else skill-ups on non-grey recipes; cooked food at most 10 levels under its
# vendor food tier counts toward the errand food stock, so errands buy less. Crafting only when ungrouped, not
# resting / travelling / on an errand or zone trip, health >= CraftMinHpPct and mana >= CraftMinManaPct; at
# most BatchMax casts per CheckIntervalMs. Ledger `selfcraft` (event 21): learn|craft|use|skip; [SelfCraft] log.
# Known gap: AutoWow.Supply.RouteCloth still mails reserve cloth stacks (only the sale is held back).
AutoWow.SelfCraft.Enable = 0
AutoWow.SelfCraft.FirstAid = 1
AutoWow.SelfCraft.Cooking = 1
AutoWow.SelfCraft.BandageTarget = 10
AutoWow.SelfCraft.BandageCloth = 20
AutoWow.SelfCraft.UseHpPct = 60
AutoWow.SelfCraft.FoodTarget = 20
AutoWow.SelfCraft.CheckIntervalMs = 20000
AutoWow.SelfCraft.BatchMax = 5
AutoWow.SelfCraft.CraftMinHpPct = 70
AutoWow.SelfCraft.CraftMinManaPct = 50

# Automatic class-quest rewards (ClassQuestPolicy.h; default 0; owner ruling 2026-09-27). At login and on every
# level change a cohort bot (AutoWow.Guilds.CohortGuids, needs AutoWow.Guilds.Enable) or supply role bot learns the
# spells and gets the class key item (stored once, skipped when owned incl. bank) of each class quest whose MinLevel
# it has reached (class and race of the quest chain), e.g. warrior stances, hunter Tame Beast / Beast Training,
# warlock demons, druid Bear / Aquatic Form, shaman Earth / Fire / Water / Air totems (Totem of the Earthen Ring at
# 30 replaces them). Quest status is never changed. Mounts 1 also grants the class mount quests (paladin, warlock,
# death knight, druid Swift Flight Form), which teach a riding skill. Ledger `classquest` (event 23): grant;
# [ClassQuest] log.
AutoWow.ClassQuests.Enable = 0
AutoWow.ClassQuests.Mounts = 0

# Cohort parties (PartyPolicy.h). Every CheckIntervalMs (world thread) ungrouped independent bots of one faction,
# one map, the same zone or within HubYards, levels spanning at most LevelSpread, form parties of MinSize..MaxSize
# when they have a reason: a dungeon of AutoWow.Dungeon.List brackets every level and the roster has a tank and a
# healer (AutoWow.Dungeon.Enable), else a group quest is in a log or offered in the zone at the bot's level.
# Roles by class (tank: warrior > paladin > druid > DK; healer: priest > shaman > druid > paladin); leader = tank,
# else highest level. Loot need-before-greed from uncommon. The leader keeps its New-RPG loop (scheduler, quests,
# errands) and puts the party's group quest first; followers "+follow,-new rpg,-grind" and assist; quests are
# pushed by the stock auto share. In a party, group quests up to the party size (dungeon quests for a dungeon
# party) are acceptable. Roles = 1: tank class tank strategy + "tank assist", healer class heal strategy +
# "healer dps", and in combat the tank taunts mobs off party members within TauntYards, the healer heals the
# lowest member below HealPct first. Disband: a member offline or out of the group, levels drift past
# LevelSpread, a member off the leader's map / beyond SeparatedYards for SeparatedMs, no reason for
# PurposelessMs, older than MaxAgeMs, dungeon done. Strategies are restored on disband; a bot rejoins no party
# for RejoinCooldownMs. Ledger `party` (event 15).
AutoWow.Party.Enable = 0
AutoWow.Party.CheckIntervalMs = 30000
AutoWow.Party.LevelSpread = 3
AutoWow.Party.HubYards = 300
AutoWow.Party.MinSize = 2
AutoWow.Party.MaxSize = 5
AutoWow.Party.SeparatedYards = 500
AutoWow.Party.SeparatedMs = 600000
AutoWow.Party.PurposelessMs = 1800000
AutoWow.Party.MaxAgeMs = 7200000
AutoWow.Party.RejoinCooldownMs = 600000
AutoWow.Party.Roles = 1
AutoWow.Party.HealPct = 60
AutoWow.Party.TauntYards = 30
# A bot-only ordinary group (at most five, every member online, no real-player master, not oracle-managed)
# that no cohort party owns is disbanded at the next formation pass: the core persists groups across a
# restart, the party registry does not. Set 0 while bridge `party` rosters of non-managed bots are in use.
AutoWow.Party.DisbandOrphans = 1

# Dungeon runs of cohort parties (needs AutoWow.Party.Enable). List = "map:minLevel:maxLevel:A|H|AH" in priority
# order (389 Ragefire Chasm, 36 Deadmines, 43 Wailing Caverns, 33 Shadowfang Keep, 48 Blackfathom Deeps, 34 The
# Stockade); the entrance is the lowest continent area trigger into the map. A dungeon party with MinSize members
# together (TogetherYards) within MaxWalkYards of the entrance walks there (leader: no-teleport long walk,
# followers follow), steps into the trigger volume and is admitted by the stock DungeonTransition; inside, the
# stock dungeon navigator leads (the leader's New-RPG is off), followers follow. Every DungeonEncounter bit set =
# completed; all dead = wiped; InsideTimeoutMs = abandoned. Exit: hearthstone when ready, then the party
# disbands (the core boots members still inside). Approach gives up after ApproachTimeoutMs or
# ApproachStuckTicks stuck walk ticks; PortalFallback = 1 (owner ruling) then teleports the party to the
# entrance instead (ledger `dungeon` portal_fallback + `contaminated`). CooldownMs between runs of one party.
# Ledger `dungeon` (event 16).
AutoWow.Dungeon.Enable = 0
AutoWow.Dungeon.List = "389:13:18:H,36:17:26:A,43:17:24:AH,33:18:25:AH,48:20:30:AH,34:22:30:A"
AutoWow.Dungeon.MinSize = 3
AutoWow.Dungeon.RequireTankHealer = 1
AutoWow.Dungeon.TogetherYards = 60
AutoWow.Dungeon.MaxWalkYards = 6000
AutoWow.Dungeon.ApproachTimeoutMs = 1800000
AutoWow.Dungeon.ApproachStuckTicks = 60
AutoWow.Dungeon.StageYards = 40
AutoWow.Dungeon.StageTimeoutMs = 120000
AutoWow.Dungeon.InsideTimeoutMs = 3600000
AutoWow.Dungeon.ExitTimeoutMs = 120000
AutoWow.Dungeon.CooldownMs = 3600000
AutoWow.Dungeon.PortalFallback = 0
# Recruit = 1 (needs Dungeon.Enable; default 0 = formation above only): every RecruitIntervalMs, per faction with
# fewer than RecruitMaxParties recruited parties, the listed dungeon whose band holds the most free cohort bots
# anywhere in one LevelSpread window (MinSize at least, one healer-capable class required, a tank preferred)
# gets a party: best healer, best tank, then dps (walk range to the entrance first, then level) up to MaxSize.
# Free = ungrouped, alive, out of combat, not in a zone graduation / errand / supply role / flight / escort,
# past RecruitCooldownMs since its last recruited run. Everyone within MaxWalkYards of the entrance on its map:
# the walk above; else the whole party takes a logged portal to the entrance (ledger `dungeon` portal_fallback,
# `contaminated` party_recruit_portal). One run, then released (party disband dungeon_done) with a `dungeon`
# summary row. Completion ignores encounters with no static spawn or set aside by the navigator.
AutoWow.Dungeon.Recruit = 0
AutoWow.Dungeon.RecruitIntervalMs = 600000
AutoWow.Dungeon.RecruitCooldownMs = 2700000
AutoWow.Dungeon.RecruitMaxParties = 1
# RequireTank = 1: a recruit window also needs a tank-capable bot (warrior, paladin, or druid knowing Bear / Dire
# Bear Form) besides its healer; the tank is picked first and gets role tank (Party.Roles: tank strategy, i.e.
# defensive stance / righteous fury / bear form). None free: no party, [Party] recruit log why=no_tank.
# RecruitStragglerWalk = 1: in a recruited party the dungeon navigator walks an idle out-of-combat member beyond
# the cohesion radius to the leader on ordinary legs too (the gate row straggler walk, recovery=gate_party_walk
# leg=route) instead of waiting blocked=party_cohesion.
AutoWow.Dungeon.RequireTank = 0
AutoWow.Dungeon.RecruitStragglerWalk = 0
# RecruitWidePool = 1: a bot that is only fighting (questing / grinding), on an errand, on a zone trip (cancelled)
# or in a formation party outside a dungeon run (dissolved, party disband `recruited`) can be recruited too.
# Always excluded: mid escort, on an instance map, on a flight / teleport, dead, supply role, squad, in a recruited
# party, within RecruitCooldownMs, paused by another runtime, in a group this registry does not own. The recruit
# log line counts every reason per faction (out={...}) and the tank-capable bots taken/total (tanks=a/b).
AutoWow.Dungeon.RecruitWidePool = 0
# RecruitTankOverLevel = N > 0: when a recruit window has no tank of its own, a recruitable tank-capable bot above
# the window up to N levels over the dungeon's max level fills the tank slot (closest level first; in-window tanks
# always go first). The recruit line logs tank_dlvl (tank level minus the dungeon max; none = no tank).
AutoWow.Dungeon.RecruitTankOverLevel = 0
# RecruitGatherPortalMs > 0 (e.g. 60000): once a recruited party reaches the entrance (Stage), a member not in
# the dungeon or at the entrance after this long is portaled there once, its taxi ended first (ledger
# `contaminated` party_recruit_gather_portal); the MemberGraceMs missing-member abandon counts a member outside
# only after that portal. A member offline, or dead outside the dungeon after the deadline, is dropped (party
# row `dropped`) and the run goes on with at least three while its tank and healer remain; else it is abandoned
# ([Party] recruit gather abandon why=leader_gone|roles_short). 0 = off.
AutoWow.Dungeon.RecruitGatherPortalMs = 0

# Dungeon navigator convoy V2 (DungeonNavigatorConvoyPolicy.h; default 0 = V1 unchanged). A follower whose
# assigned trailing route slot is unreachable settles on the furthest reachable route point at or below it that
# it already stands on (within 3 yd) instead of bouncing between the points around it, and never steps below that
# point while the leader frontier is unchanged. The shared-regroup terminal latches only after the full attempt
# budget (V1 latched on the first attempt at slot 0) and is released when the leader frontier moves or the member
# is back within 45 yd of the leader. Leader side: the backward re-anchor no longer rewinds onto the point the
# leader was just marked arrived at, and a navmesh gap (NOPATH) to the immediate next route point within 15 yd
# horizontal / 5.5 yd vertical is walked along the reversed safe probe from that point (2 tries per hop).
# Toward a boss with a curated leg (DungeonRoutePolicy.h; Deadmines door -> Mr. Smite -> Cookie -> Captain
# Greenskin -> Edwin VanCleef along the dock walkway, gangplank and ship decks) the leader walks the leg point by
# point instead of travel nodes, the cove swim or a direct move, from within 40 yd of it until 8 yd from the boss;
# logs "route_source=curated leg=<encounter> point=<n>". Wailing Caverns legs reach Lord Serpentis, Verdan and the
# Disciple of Naralex; their two direct points (the step onto the Serpentis ledge, the 28 yd drop off it) are taken
# by each party member with a straight move without pathfinding, only from within 8 yd of the previous point and
# for at most 8 yd across, 30 yd down, 6 yd up ("kind=direct"); a mover not there within 10 s logs result=failed
# and the step is not retried in that instance (the leader's curated route then falls back to the ordinary one).
# Read once at first use.
AutoWow.DungeonNav.ConvoyV2 = 0

# Dungeon navigator scripted progression steps (DungeonGatePolicy.h; default 0 = off, navigator unchanged). A
# compiled-in step table (gossip, escorts, gongs, fires, altars, statues, kill sets, proxy kills; see
# docs/DUNGEON_GATES.md) makes an unfinished encounter with rows travel to its first unfinished step instead of the
# boss; the step runs only out of combat with the party within 38.5 yd, then waits for its done condition or its
# timeout (optional rows are then skipped, required rows start over). Logs "[DungeonNavigator] gate map= enc= step=
# kind= entry= result=". On maps with rows the older nearest-button interaction rule is off. Read once at first use.
AutoWow.DungeonNav.Gates = 0

# Also run step rows that name a key item (the core does not check GO locks on bot use). Default 0: key rows are
# skipped. Needs AutoWow.DungeonNav.Gates = 1. Read once at first use.
AutoWow.DungeonNav.Gates.BypassKeys = 0

# Consumable economy for independent bots (ErrandsPolicy.h; default 0; needs AutoWow.Errands.Enable = 1,
# inert otherwise). Real gold only, no free items. With it on: no food left (no drink, mana users) is an
# urgent errand need; a restock counts as affordable when money + the vendor value of the grey loot covers
# one pack of each needed kind; at the town every vendor stop sells greys first and the restock buys to
# FoodLow/WaterLow for every kind (food first) before topping up to the targets, counting purchases by
# the stock change (the core buy call reports false after a buy from an unlimited vendor slot, so the
# plain loop bought one pack per run); a bot passing a friendly vendor within SellDetourYards walks over
# and sells its greys (one 30 s detour, then 5 min before the next). Read once at world init.
AutoWow.Survival.KeepConsumables = 0
AutoWow.Survival.KeepConsumables.SellDetourYards = 30

# Auction-house trade for independent bots (TradePolicy.h; default 0; needs AutoWow.Errands.Enable = 1,
# inert otherwise). A town run whose town has an auctioneer adds an auction stop, and one with a mailbox
# a mail stop (after every other stop). At the auctioneer: list up to MaxPosts stacks the bot does not
# need (stock item usage `ah`; greens and better, or trade goods / reagents / gems) one below the lowest
# competing buyout per unit, else at PriceMultPct of the vendor price, never below FloorPct of it
# (deposits <= half the bot's money); then buy with buyout at most one equippable upgrade (stock item
# usage equip/replace) and profession mats the bot lacks (stock usage `skill`, <= MatUnitMaxPct of the
# vendor price per unit), spending <= BuyBudgetPct of the money above the class-trainer budget. At the
# mailbox: take the money and items of delivered, non-COD mail (sales, expiries, won auctions). Real gold:
# the core auction / mail handlers run in the world thread. Ledger `trade` (event 17) per result.
AutoWow.Trade.Enable = 0
AutoWow.Trade.PriceMultPct = 300
AutoWow.Trade.FloorPct = 150
AutoWow.Trade.MaxPosts = 6
AutoWow.Trade.BuyBudgetPct = 50
AutoWow.Trade.MatUnitMaxPct = 400
# DeleteEmptyMail: the mail collector deletes every delivered mail left with no money and no items (not COD), as the
# client does ("[Trade] ... deleted empty mails"); an AutoWow.Supply role bot also visits its mailbox for them.
# soak-s48-full-r1: emptied mails are never deleted otherwise and filled the Weavers rep's box to the core cap of 100.
AutoWow.Trade.DeleteEmptyMail = 1

# Faction treasury counter, stage 1 (default 0; needs AutoWow.Ledger.Enable = 1): ledger `trade` action
# `fee` lines (kind flight|repair|train) for copper independent bots pay to the world: the New RPG flight
# fare (first hop as charged at take-off) and errand repairs / training. scripts/ledger-reduce.py sums them
# with auction fees (deposits + cuts) per faction. Telemetry only, no gameplay effect.
AutoWow.Ledger.Treasury = 0

# Full-bag stall relief for an incomplete collect-item quest blocked by 100% bag occupancy.
# 1 = bounded escalation: existing vendor relief (safe-gray sale / bounded bag purchase) for at most
# 2 minutes of the episode, then destroy the single lowest-value safe gray item (never quest items,
# trade goods, reagents, recipes, equipped items, or anything above gray quality), else defer the
# quest (ledger `deferred` reason inventory_full) and skip re-evaluation for 5/10/20/40/60 s.
# Default 0 = legacy behavior (vendor relief, else hold Blocked).
AutoWow.QuestFullBagRelief.Enable = 0

# Starter-stall lane (soak-s5-cohort-r2). All default 0 = legacy behavior, byte-identical paths.
# Travel no-progress watch for New RPG quest source/finisher travel (non-Oracle directives only).
# MoveFarTo's stuck counter is re-armed by every prepared walk segment, so two alternating segments
# (A -> B -> A, seen at Coldridge/Valley of Trials/Mulgore) never trip it and the bot burns the whole
# 30-minute DO_QUEST window. 1 = if the best distance to the destination has not improved by 10 yd
# within 150 s of observed out-of-combat travel, rotate to another resolved source spawn, else block
# with reason travel_no_progress.
AutoWow.QuestTravelProgressWatch.Enable = 0
# Committed travel intent (TravelIntentPolicy.h). 1 = no-teleport travellers (quest source/finisher
# travel, AutoWow roster) commit to one route segment toward the goal and replan only on events:
# segment reached / interrupted / unsafe, goal moved, ReplanFailCount consecutive failures (block
# intent_replan_exhausted), or no 10 yd net progress toward the GOAL within ProgressWindowMs of observed
# travel (block intent_no_progress). A segment returning to a recent segment point is refused (no A-B-A
# bounce); a replacement for a live segment must be HysteresisPct closer to the goal. 0 = legacy.
AutoWow.TravelIntent.Enable = 0
AutoWow.TravelIntent.ReplanFailCount = 5
AutoWow.TravelIntent.ProgressWindowMs = 90000
AutoWow.TravelIntent.HysteresisPct = 20
# Chunked long walks (WalkingV2Policy.h; needs AutoWow.TravelIntent.Enable = 1). 1 = a travel goal more
# than 120 yd away is walked in chunks: a sub-goal 120 yd (then 60 yd) along the bearing, fanned 0/30/60/90
# degrees, is pathed on its own and its endpoint committed only when it brings the goal 10 yd closer (no
# revisit refusal needed); an interrupted segment is replanned from where the bot stands without charging
# the replan budget (only a replan with no candidate counts); zone-progression roads never join a point
# the bot is already past. Fixes long walks (zone moves, town runs) that asked the navmesh for the whole
# 300-2000 yd route, which its 74-point path cap refuses. 0 = legacy.
AutoWow.Walking.V2 = 0
# Safe travel for independent bots on an errand run or a zone-progression trip (SafeTravel.h). 1 = on such
# a trip no proactive pull and no optional looting (attackers are still fought), and a walk leg does not
# resume below the AutoWow.Survival.RestGate hp/mana thresholds (eats/drinks when that flag is on, else
# regenerates); with AutoWow.Walking.V2 a chunk whose mmap path passes within aggro range (+5 yd) of an
# idle hostile mob at or above the bot's level (or any elite) is taken only when no clear chunk exists,
# and a chunk path through a death-loop danger area is refused; a town run whose walk is exhausted gets
# one rescue leg (hearthstone to a serving bound town, else a known flight) before travel_gave_up.
# 0 = legacy.
AutoWow.Travel.Safe = 0
# Flight-master trap exit (FlightTrapPolicy.h). 1 = an RPG TravelFlight status whose walk to the flight
# master the travel intent gave up on, or that has not boarded within TimeoutMs, ends in Idle, and that
# master is skipped by every flight pick for this bot (random TravelFlight, death-loop relocation, errands,
# zone progression) for CooldownMs; errands and zone progression then walk their leg. Log: [FlightTrap].
# 0 = legacy (the status only ends on landing). Makes RpgStatusProbWeight.TravelFlight safe to re-enable.
AutoWow.Travel.FlightTrapFix = 0
AutoWow.Travel.FlightTrapFix.TimeoutMs = 600000
AutoWow.Travel.FlightTrapFix.CooldownMs = 1800000
# Multi-floor travel for the Walking V2 mover (NavmeshSnap.h; needs AutoWow.TravelIntent.Enable and
# AutoWow.Walking.V2). 1 = mover paths are computed without PathGenerator's slope check (it failed every
# path whose first step climbs a hill, ramp or stair: the segments=0 give-ups below Thelsamar, Thunder
# Bluff, the Sepulcher, Tranquillien, Booty Bay), the goal is snapped to the nearest navmesh point within
# 4 yd / +-30 yd z (its own floor), and a quest source walk that gives up tries the next resolved spawn
# before blocking. 0 = legacy.
AutoWow.Travel.VerticalSnap = 0
# Blocked-quest defer-and-return (non-Oracle directives only). 1 = a quest held in Blocked for 30 s is
# deferred for 10 minutes (ledger `deferred` reason blocked_deferred) and the bot returns to Idle to pick
# other work; the quest is eligible again after the deferral. 0 = hold Blocked until the 30-minute
# DO_QUEST status timeout (legacy).
AutoWow.QuestBlockedDefer.Enable = 0
# Quest-item (CAST) targets honor the item spell's explicit-target conditions (conditions source 17).
# 1 = skip creatures that fail them (q5441: only sleeping peons, aura 17743) and, when the credit
# creature has no spawns, resolve the spell's CONDITION_OBJECT_ENTRY_GUID creature entries as the
# travel/use targets (q9303: 16518 Nestlewood Owlkin for credit 16534). 0 = legacy.
AutoWow.QuestItemTargetConditions.Enable = 0

# Quest-log scheduler (probe signature select:fixation_starved). 0 = legacy: DO_QUEST picks one quest-log
# entry at random and works it until reward, an unsupported blocker or the 30-minute DO_QUEST timeout.
# 1 = deterministic pick (QuestSchedulerPolicy.h): turn-ins first, then level-appropriate quests, then
# grey quests within 100 yd; within a tier the nearest objective POI wins, with a 150 yd bonus for a quest
# whose counters moved in the last 5 min; ties by quest id. Grey incomplete quests farther than 100 yd are
# dropped (ledger `deferred` reason sched_drop_grey). A non-Oracle directive with no counter progress for
# 5 min (10 min for a turn-in) rotates: 10-minute cooldown, ledger `deferred` reason sched_rotate, Idle.
AutoWow.QuestScheduler.Enable = 0
# PreferGearRewards (default 0; needs QuestScheduler.Enable): a quest whose reward (choice or fixed) the
# stock "item upgrade" value rates as an upgrade for the bot (empty slot, or better than the equipped item
# for its class/spec weights) counts as 300 yd nearer for a weapon, 150 yd for any other equippable item.
# Gear comes only from quest rewards, loot and vendors; nothing is granted.
AutoWow.QuestScheduler.PreferGearRewards = 0
# Quest avoid list (default empty = off). Avoided quests fail IsQuestCapableDoing: never accepted, never
# chosen for DO_QUEST, pruned when the log fills. Ids separated by commas or whitespace, '#' comments.
# AutoWow.QuestAvoidFile names a file in the same format (read once at load; the union of both is used).
# AutoWoW probe/render-avoid.ps1 renders either form from probe/avoid-quest-ids.txt.
AutoWow.QuestAvoidIds = ""
AutoWow.QuestAvoidFile = ""
# Quests pre-inserted into every bot's lowPriorityQuest set (not chosen for DO_QUEST; still accepted).
AutoWow.QuestLowPriorityIds = ""

# PvP realms (GameType 1/6/8): random bots normally get SetPvP(true) at login and on every
# refresh/revive, which flags them in every zone. 1 = skip that forced write on PvP realms so the
# core zone rules decide (hostile/contested territory flags, own territory does not). PvE realms
# are unchanged either way (SetPvP(false)). Default 0 = legacy forced flag on every realm type.
AutoWow.PvpRealmZoneRules.Enable = 0

# Level-up maintenance for AutoWoW independent bots that are neither random-pool bots nor listed in
# AutoWow.OracleRuntime.BotGuids (e.g. the persistent cohort, docs/COHORT_PLAN.md C2). Those two
# groups are unaffected. Never grants gear, consumables, ammo, reagents or money in any mode.
# 0 (default) = legacy: no automatic talents or spells.
# 1 = auto-assign talents on level-up (AiPlayerbot.AutoPickTalents must also be on). Spells are NOT
#     learned; note the independent strategy set has no trainer-visit path (legacy `rpg train` lives
#     only in the removed `rpg` strategy), so mode 1 bots stay on their level-1 spells.
# 2 = mode 1 + class spells on level-up: class trainer spells (no tradeskill recipes, no riding or
#     weapon-skill grants), class quest reward spells and the hunter pet
#     (AiPlayerbot.AutoLearnTrainerSpells / AutoLearnQuestSpells must also be on).
AutoWow.Independent.AutoMaintenance = 0

# AutoWoW cohort professions (docs/PROFESSIONS_PLAN.md P1). All default off; read once at world init.
# Enable 1 = bots listed in Assignments are "planned": a trainer visit only starts their assigned
# primaries and the Secondaries (rank-ups/recipes of lines they already have still pass), always for
# real gold; the free profession paths (factory InitTradeSkills random professions/skill values,
# level-up tradeskill-trainer spells, Oracle arm-time profession reconcile) are skipped for them,
# in both cohort arms. Unlisted bots keep the legacy behavior.
AutoWow.Professions.Enable = 0
# TrainOnArrival 1 (needs Enable) = a planned bot that the new-rpg wander-npc step brings to a
# friendly trainer (class or profession) learns every spell it can afford there (real gold, learn
# filter above). No directed trainer travel yet (P2).
AutoWow.Professions.TrainOnArrival = 0
# guid:skill[,skill];guid:skill[,skill];... primary skill line ids (164 BS, 165 LW, 171 Alch, 182 Herb,
# 186 Mining, 197 Tail, 202 Eng, 333 Ench, 393 Skin, 755 JC, 773 Insc), at most 2 per guid. Rendered
# from the cohort manifest v2 by AutoWoW scripts/cohort/profession-assign.ps1. A malformed value is
# rejected whole (logged; no bot is planned).
AutoWow.Professions.Assignments = ""
# Secondary professions every planned bot may learn (129 First Aid, 185 Cooking, 356 Fishing).
AutoWow.Professions.Secondaries = "129,185,356"
# CraftPriorityFix 1 = the random craft action prefers useful / skill-up recipes (GetSpellPriority
# compared create-item with `!=`, and the sort ignored priority). Default 0 = legacy order.
AutoWow.Professions.CraftPriorityFix = 0
# TrainRuns 1 (needs Enable and AutoWow.Errands.Enable) = a planned bot missing one of its planned
# professions, or capped at a rank max (75/150/225/300/375) with the next rank's level reached, starts an
# errand run on its own, to the nearest same-map town whose trade trainer teaches it a planned rank now
# (the stock trainer action + learn filter). At most one such check per TrainRunCooldownMs (ms, default
# 1800000). Logs "[Professions] train_due", and "[Professions] learn" / "[Professions] rank_up" for every
# profession spell a player learns while the flag is on. Default 0.
AutoWow.Professions.TrainRuns = 0
AutoWow.Professions.TrainRunCooldownMs = 1800000

# Gathering rule 2026-09-28 (owner, "Warcraft redefined"; src/AutoWow/GatherScalePolicy.h). All default 0.
# d = required skill - current skill (node lock skill; corpse: the core's skinning red level).
# AnySkill 1 = a player who knows Herbalism / Mining / Skinning (skill >= 1) may gather any node or corpse
#   of that profession regardless of skill. Needs the core patch (core-patches/series, Spell::CanOpenLock and
#   the skinning CheckCast read this same key); the bot-side loot / reveal / gather-seek gates follow it.
AutoWow.Gather.AnySkill = 0
# YieldScale 1 = gathered stacks shrink with d: count * max(0, 100 - 2*d) / 100, never below 1 unit
#   (full at d <= 0, half at d = 25, one unit from d = 50). d > 50 turns a known material into its
#   previous tier (e.g. Iron Ore -> Tin Ore, Kingsblood -> Briarthorn, Heavy Leather -> Medium Leather).
AutoWow.Gather.YieldScale = 0
# MultiGain 1 = a gathering skill-up with d > 0 is 1 + d/25 points (at most 5), never past the rank max.
AutoWow.Gather.MultiGain = 0
# Craft.MultiGain 1 = a skill-up from an orange recipe (skill below its yellow level) is one point more,
#   never past the rank max.
AutoWow.Craft.MultiGain = 0

# Bot chat safety (soak-s5-cohort-r1 chat storm). Bots that hear chat decide whether the speaker is a
# bot (reply cooldown, low odds) or a real player (no cooldown, eager replies naming the speaker).
# BotSpeakerByAI 1 = a speaker is also a bot when it is a connected player driven by a PlayerbotAI
# (cohort/independent/alt bots on normal accounts). Default 0 = legacy: only random-pool accounts.
AutoWow.Chat.BotSpeakerByAI = 0

# MinReplyIntervalMs: hard floor between queued chat replies per bot, in ms. Only bounds a runaway
# reply loop; 0 = unbounded (legacy). Default 5000.
AutoWow.Chat.MinReplyIntervalMs = 5000

# Soak setup rule. 1 = when a RANDOM bot logs in above AiPlayerbot.RandomBotMaxLevel (legacy pool
# entries whose randomize timers lie past the soak), re-roll it once through the normal
# RandomizeFirst level path (level/gear/teleport for level) and emit ledger `contaminated` reason
# setup_reroll first. Never applies to non-random bots or to GUIDs listed in
# AutoWow.OracleRuntime.BotGuids / AutoWow.FixtureGuids / AutoWow.MicroScenarioGuids.
# Default 0 = off.
AutoWow.Soak.RerollAboveMaxLevel = 0

# 1 = compute the shared "quest guidp map" (every quest-relevant creature/GO spawn) once at world
# startup on the world thread, instead of lazily on the first bot that asks for it (possibly on a
# map-update thread, racing other first readers). Costs one catalog scan at startup (logged).
# Default 0 = lazy first compute (legacy).
AutoWow.WarmQuestSpawnMap = 0

#
#
####################################################################################################

####################################################################################################
# DEBUG SWITCHES
#

AiPlayerbot.SpellDump = 0
AiPlayerbot.LogInGroupOnly = 1
AiPlayerbot.LogValuesPerTick = 0
AiPlayerbot.RandomChangeMultiplier = 1

# Tell which spell is avoiding (experimental)
# Default: 0 (disabled)
AiPlayerbot.TellWhenAvoidAoe = 0

# Enable/Disable performance monitor
AiPlayerbot.PerfMonEnabled = 0

#
#
####################################################################################################

####################################################################################################
# CHAT SETTINGS
#

# Prefix for bot chat commands (e.g., follow, stay)
AiPlayerbot.CommandPrefix = ""

# Separator for bot chat commands
AiPlayerbot.CommandSeparator = "\\\\"

# Enable automatic item count/trade trigger when a chat message contains
# item-related keywords. When enabled (1), mentioning items in chat
# (e.g. "food", "potion", "ammo") will automatically show inventory and
# open a trade window with the bot. Explicit "c" and "t" commands still
# work regardless of this setting.
# Default: 1 (enabled)
AiPlayerbot.EnableAutoTradeOnItemMention = 1

# Enable bots talking (say / yell / general chatting / lfg)
AiPlayerbot.RandomBotTalk = 1
# Enable bots emoting
AiPlayerbot.RandomBotEmote = 0
# Enable randombots suggesting dungeons in chat
AiPlayerbot.RandomBotSuggestDungeons = 1
# Bots greet players when invited
AiPlayerbot.EnableGreet = 0
# Chance to reply to toxic links with toxic links (0-100)
AiPlayerbot.ToxicLinksRepliesChance = 30
# Chance to reply to Thunderfury with Thunderfury (0-100)
AiPlayerbot.ThunderfuryRepliesChance = 40
# Enable bots chatting in guild about certain events
AIPlayerbot.GuildFeedback = 1
# Chance bots will chat in guild about certain events (int) (0-100)
AiPlayerbot.GuildRepliesRate = 100
# Bots without a master will say their lines
AiPlayerbot.RandomBotSayWithoutMaster = 0

#
#
####################################################################################################

####################################################################################################
# Broadcast rates
#

# Enable/disable broadcasts globally
# Default: 1 (enabled)
AiPlayerbot.EnableBroadcasts = 1

# All broadcast chances should be in range 0-30000
# Value of 0 will disable this particular broadcast
# Setting value to 30000 does not guarantee the broadcast, as there are some internal randoms as well
# Setting channel broadcast chance to 0 will re-route most broadcasts to other available channels
# Setting all channel broadcasts to 0 will disable most broadcasts
AiPlayerbot.BroadcastToGuildGlobalChance = 30000
AiPlayerbot.BroadcastToWorldGlobalChance = 30000
AiPlayerbot.BroadcastToGeneralGlobalChance = 30000
AiPlayerbot.BroadcastToTradeGlobalChance = 30000
AiPlayerbot.BroadcastToLFGGlobalChance = 30000
AiPlayerbot.BroadcastToLocalDefenseGlobalChance = 30000
AiPlayerbot.BroadcastToWorldDefenseGlobalChance = 30000
AiPlayerbot.BroadcastToGuildRecruitmentGlobalChance = 30000

# Individual settings
# Setting one of these to 0 will disable the particular broadcast
AiPlayerbot.BroadcastChanceLootingItemPoor = 30
AiPlayerbot.BroadcastChanceLootingItemNormal = 150
AiPlayerbot.BroadcastChanceLootingItemUncommon = 10000
AiPlayerbot.BroadcastChanceLootingItemRare = 20000
AiPlayerbot.BroadcastChanceLootingItemEpic = 30000
AiPlayerbot.BroadcastChanceLootingItemLegendary = 30000
AiPlayerbot.BroadcastChanceLootingItemArtifact = 30000

AiPlayerbot.BroadcastChanceQuestAccepted = 6000
AiPlayerbot.BroadcastChanceQuestUpdateObjectiveCompleted = 300
AiPlayerbot.BroadcastChanceQuestUpdateObjectiveProgress = 300
AiPlayerbot.BroadcastChanceQuestUpdateFailedTimer = 300
AiPlayerbot.BroadcastChanceQuestUpdateComplete = 1000
AiPlayerbot.BroadcastChanceQuestTurnedIn = 10000

AiPlayerbot.BroadcastChanceKillNormal = 30
AiPlayerbot.BroadcastChanceKillElite = 300
AiPlayerbot.BroadcastChanceKillRareelite = 3000
AiPlayerbot.BroadcastChanceKillWorldboss = 20000
AiPlayerbot.BroadcastChanceKillRare = 10000
AiPlayerbot.BroadcastChanceKillUnknown = 100
AiPlayerbot.BroadcastChanceKillPet = 10
AiPlayerbot.BroadcastChanceKillPlayer = 30

AiPlayerbot.BroadcastChanceLevelupGeneric = 20000
AiPlayerbot.BroadcastChanceLevelupTenX = 30000
AiPlayerbot.BroadcastChanceLevelupMaxLevel = 30000

AiPlayerbot.BroadcastChanceSuggestInstance = 5000
AiPlayerbot.BroadcastChanceSuggestQuest = 10000
AiPlayerbot.BroadcastChanceSuggestGrindMaterials = 5000
AiPlayerbot.BroadcastChanceSuggestGrindReputation = 5000
AiPlayerbot.BroadcastChanceSuggestSell = 300
AiPlayerbot.BroadcastChanceSuggestSomething = 30000

# Bots will say very rude things
AiPlayerbot.BroadcastChanceSuggestSomethingToxic = 0

# Specifically for "<word> [item link]"
AiPlayerbot.BroadcastChanceSuggestToxicLinks = 0

# Prefix is used as a word in "<word> [item link]"
AiPlayerbot.ToxicLinksPrefix = gnomes

# Chance to suggest Thunderfury
AiPlayerbot.BroadcastChanceSuggestThunderfury = 1

# Does not depend on global chance
AiPlayerbot.BroadcastChanceGuildManagement = 30000

#
#
####################################################################################################

####################################################################################################
# LOGS
#

# Custom config to allow logfiles to be created.
# Example: AiPlayerbot.AllowedLogFiles = travelNodes.csv,travelPaths.csv,TravelNodeStore.h,bot_movement.csv,bot_location.csv
AiPlayerbot.AllowedLogFiles = ""

#
#
####################################################################################################

##############################################
# Deprecated Settings (yet still in use)     #
##############################################

# Guild Task system
AiPlayerbot.EnableGuildTasks = 0

# Chance bot chooses RPG (Teleport to random camp for their level) instead of grinding
AiPlayerbot.RandomBotRpgChance = 0.20

# Set randombots movement speed to walking anywhere
AiPlayerbot.RandombotsWalkingRPG = 0

# Set randombots movement speed to walking only inside buildings
AiPlayerbot.RandombotsWalkingRPG.InDoors = 0

AiPlayerbot.MinRandomBotsPriceChangeInterval = 7200
AiPlayerbot.MaxRandomBotsPriceChangeInterval = 172800
AiPlayerbot.MinRandomBotChangeStrategyTime = 180
AiPlayerbot.MaxRandomBotChangeStrategyTime = 720

# How often tasks are changed
AiPlayerbot.MinGuildTaskChangeTime = 172800
AiPlayerbot.MaxGuildTaskChangeTime = 432000

# Mail spam interval
AiPlayerbot.MinGuildTaskAdvertisementTime = 300
AiPlayerbot.MaxGuildTaskAdvertisementTime = 28800

# Delay before reward is sent
AiPlayerbot.MinGuildTaskRewardTime = 300
AiPlayerbot.MaxGuildTaskRewardTime = 3600

# Cleanup of guild tasks interval
AiPlayerbot.GuildTaskAdvertCleanupTime = 300

# Specify max distance between victim and bot when creating guild kill task
AiPlayerbot.GuildTaskKillTaskDistance = 200

# Distance margin for facade calculations
AiPlayerbot.TargetPosRecalcDistance = 0.1

# Allow bots to be summoned near innkeepers
AiPlayerbot.SummonAtInnkeepersEnabled = 1
