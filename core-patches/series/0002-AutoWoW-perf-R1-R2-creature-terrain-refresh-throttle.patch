index 0c1e8b75f..2f506ce66 100644
--- a/src/server/game/Entities/Creature/Creature.cpp
+++ b/src/server/game/Entities/Creature/Creature.cpp
@@ -22,6 +22,7 @@
 #include "CreatureAI.h"
 #include "CreatureAISelector.h"
 #include "CreatureGroups.h"
+#include "CreatureTerrainRefresh.h"
 #include "MoveSpline.h"
 #include "DatabaseEnv.h"
 #include "Formulas.h"
@@ -3175,14 +3176,54 @@ std::string Creature::GetScriptName() const
 
 uint32 Creature::GetScriptId() const
 {
+    // AutoWoW perf R2: re-resolve only when entry or creature data changed (UpdateEntry, SetEntry, LoadFromDB).
+    uint32 const entry = GetEntry();
+    if (entry == _scriptIdCacheEntry && m_creatureData == _scriptIdCacheData)
+        return _scriptIdCache;
+
+    uint32 scriptId = 0;
     if (CreatureData const* creatureData = GetCreatureData())
-    {
-        uint32 scriptId = creatureData->ScriptId;
-        if (scriptId && GetEntry() == creatureData->id)
-            return scriptId;
-    }
+        if (creatureData->ScriptId && entry == creatureData->id)
+            scriptId = creatureData->ScriptId;
+
+    if (!scriptId)
+        scriptId = sObjectMgr->GetCreatureTemplate(entry)->ScriptID;
+
+    _scriptIdCache = scriptId;
+    _scriptIdCacheData = m_creatureData;
+    _scriptIdCacheEntry = entry;
+    return scriptId;
+}
+
+bool Creature::ShouldRefreshTerrainOnRelocation(bool cellChanged) const
+{
+    uint32 const refreshMs = sWorld->getIntConfig(CONFIG_AUTOWOW_PERF_CREATURE_TERRAIN_REFRESH_MS);
+    float const refreshYards = sWorld->getFloatConfig(CONFIG_AUTOWOW_PERF_CREATURE_TERRAIN_REFRESH_YARDS);
+    if (!refreshMs && refreshYards <= 0.0f)
+        return true; // throttle OFF: legacy behavior, refresh on every relocation
+
+    // Only mid-spline steps of AI-driven creatures are throttled; everything that must be exact refreshes.
+    bool const forced = cellChanged
+        || !_terrainRefreshValid
+        || _terrainRefreshPhase != GetPhaseMask()
+        || movespline->Finalized() // spline arrival, teleport, direct SetPosition / non-spline relocation
+        || IsFalling()
+        || IsVehicle() || GetVehicle() || GetTransport()
+        || IsControlledByPlayer() || IsCharmedOwnedByPlayerOrPlayer();
+
+    uint32 const msSinceRefresh = uint32(GameTime::GetGameTimeMS().count()) - _terrainRefreshMs;
+    return Acore::AutoWowPerf::ShouldRefreshCreatureTerrain(refreshMs, refreshYards, forced, GetExactDistSq(&_terrainRefreshPos), msSinceRefresh);
+}
+
+void Creature::ProcessPositionDataChanged(PositionFullTerrainStatus const& data)
+{
+    Unit::ProcessPositionDataChanged(data);
 
-    return sObjectMgr->GetCreatureTemplate(GetEntry())->ScriptID;
+    // AutoWoW perf R1: every full terrain refresh (any path: relocation, Create, lazy getters) restamps the throttle.
+    _terrainRefreshPos.Relocate(GetPositionX(), GetPositionY(), GetPositionZ());
+    _terrainRefreshMs = uint32(GameTime::GetGameTimeMS().count());
+    _terrainRefreshPhase = GetPhaseMask();
+    _terrainRefreshValid = true;
 }
 
 VendorItemData const* Creature::GetVendorItems() const
