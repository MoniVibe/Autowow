+#include "CreatureTerrainRefresh.h"
+#include "gtest/gtest.h"
+
+using Acore::AutoWowPerf::ShouldRefreshCreatureTerrain;
+
+TEST(CreatureTerrainRefreshTest, OffAlwaysRefreshes)
+{
+    EXPECT_TRUE(ShouldRefreshCreatureTerrain(0, 0.0f, false, 0.0f, 0));
+    EXPECT_TRUE(ShouldRefreshCreatureTerrain(0, 0.0f, false, 0.01f, 1));
+}
+
+TEST(CreatureTerrainRefreshTest, SmallStepWithinWindowSkips)
+{
+    // 1 yd moved (dist^2 = 1), 100 ms elapsed, thresholds 1.5 yd / 400 ms
+    EXPECT_FALSE(ShouldRefreshCreatureTerrain(400, 1.5f, false, 1.0f, 100));
+}
+
+TEST(CreatureTerrainRefreshTest, DistanceTriggers)
+{
+    EXPECT_TRUE(ShouldRefreshCreatureTerrain(400, 1.5f, false, 2.25f, 0));      // exactly 1.5 yd
+    EXPECT_FALSE(ShouldRefreshCreatureTerrain(400, 1.5f, false, 2.24f, 0));
+    EXPECT_TRUE(ShouldRefreshCreatureTerrain(0, 1.5f, false, 100.0f, 0));       // yards-only mode
+    EXPECT_FALSE(ShouldRefreshCreatureTerrain(0, 1.5f, false, 1.0f, 999999));   // no time trigger when ms == 0
+}
+
+TEST(CreatureTerrainRefreshTest, TimeTriggers)
+{
+    EXPECT_TRUE(ShouldRefreshCreatureTerrain(400, 1.5f, false, 0.0f, 400));
+    EXPECT_FALSE(ShouldRefreshCreatureTerrain(400, 1.5f, false, 0.0f, 399));
+    EXPECT_TRUE(ShouldRefreshCreatureTerrain(250, 0.0f, false, 1.0e6f, 250));   // ms-only mode
+    EXPECT_FALSE(ShouldRefreshCreatureTerrain(250, 0.0f, false, 1.0e6f, 10));   // no distance trigger when yards == 0
+}
+
+TEST(CreatureTerrainRefreshTest, ForcedAlwaysRefreshes)
+{
+    // cell change, spline end/teleport, phase change, falling, vehicle/transport, player-controlled => forced
+    EXPECT_TRUE(ShouldRefreshCreatureTerrain(400, 1.5f, true, 0.0f, 0));
+    EXPECT_TRUE(ShouldRefreshCreatureTerrain(0, 1.5f, true, 0.0f, 0));
+    EXPECT_TRUE(ShouldRefreshCreatureTerrain(400, 0.0f, true, 0.0f, 0));
+}
