diff --git a/src/server/apps/worldserver/worldserver.conf.dist b/src/server/apps/worldserver/worldserver.conf.dist
index 6f0e0a9f8..15a8b6b01 100644
--- a/src/server/apps/worldserver/worldserver.conf.dist
+++ b/src/server/apps/worldserver/worldserver.conf.dist
@@ -3006,6 +3006,24 @@ CreatureFamilyFleeAssistanceRadius = 30
 
 CreatureLeashRadius = 30
 
+#
+#    AutoWow.Perf.CreatureTerrainRefreshMs
+#    AutoWow.Perf.CreatureTerrainRefreshYards
+#        Description: AutoWoW perf throttle for the full terrain query (zone/area, floor Z,
+#                     liquid, outdoors) a creature re-runs on every movement step. When either
+#                     value is > 0, a mid-spline creature step re-queries terrain only if it
+#                     crossed a grid cell, moved >= Yards since the last query, or >= Ms passed.
+#                     Always re-queried: spline end/teleport/direct set-position, phase change,
+#                     falling, vehicles/passengers/transports, player-controlled creatures.
+#                     Players are never throttled. Swim/fly flag and zone changes on moving
+#                     creatures can lag by up to the thresholds.
+#        Default:     0 - (Both 0 = disabled, query on every step - legacy behavior)
+#        Example:     AutoWow.Perf.CreatureTerrainRefreshMs = 400
+#                     AutoWow.Perf.CreatureTerrainRefreshYards = 1.5
+
+AutoWow.Perf.CreatureTerrainRefreshMs = 0
+AutoWow.Perf.CreatureTerrainRefreshYards = 0
+
 #
 #    CreatureFamilyAssistanceRadius
 #        Description: Distance for creatures calling for assistance from other creatures without
